<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">how do real assets encode it, how does CPU memory reach GPU memory</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">correctly, how do thousands of materials scale, and how do we prove</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">the resulting renderer is actually correct?</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{how do real assets encode it, how does CPU memory reach GPU memory}\\\text{correctly, how do thousands of materials scale, and how do we prove}\\\text{the resulting renderer is actually correct?}\end{gathered}}</annotation></semantics></math>