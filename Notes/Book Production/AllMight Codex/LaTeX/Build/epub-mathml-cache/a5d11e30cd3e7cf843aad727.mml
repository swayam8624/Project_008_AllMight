<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mfrac><mrow><mi>F</mi><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>+</mo><mi>h</mi><msub><mi>d</mi><mi>x</mi></msub><mo>,</mo><mn>2</mn><mo>+</mo><mi>h</mi><msub><mi>d</mi><mi>y</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>−</mo><mi>F</mi><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><mi>h</mi><msub><mi>d</mi><mi>x</mi></msub><mo>,</mo><mn>2</mn><mo>−</mo><mi>h</mi><msub><mi>d</mi><mi>y</mi></msub><mo stretchy="false" form="postfix">)</mo></mrow><mrow><mn>2</mn><mi>h</mi></mrow></mfrac><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{F(1+hd_x,2+hd_y)-F(1-hd_x,2-hd_y)}{2h},</annotation></semantics></math>