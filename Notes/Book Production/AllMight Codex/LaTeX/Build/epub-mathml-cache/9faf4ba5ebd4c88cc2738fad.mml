<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>X</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mo>=</mo>
  <mi>Z</mi>
  <msubsup>
    <mi>V</mi>
    <mi>k</mi>
    <mrow data-mjx-texclass="ORD">
      <mi mathvariant="sans-serif">T</mi>
    </mrow>
  </msubsup>
  <mo>+</mo>
  <mrow data-mjx-texclass="ORD">
    <mn mathvariant="bold">1</mn>
  </mrow>
  <msup>
    <mi>&#x3BC;</mi>
    <mrow data-mjx-texclass="ORD">
      <mi mathvariant="sans-serif">T</mi>
    </mrow>
  </msup>
</math>