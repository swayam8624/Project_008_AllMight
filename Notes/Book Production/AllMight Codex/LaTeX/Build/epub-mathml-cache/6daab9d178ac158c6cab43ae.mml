<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><msub><mi>d</mi><mn>00</mn></msub></mtd><mtd columnalign="center" style="text-align: center"><msub><mi>d</mi><mn>01</mn></msub></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mspace width="0.222em"></mspace><msub><mi>d</mi><mn>01</mn></msub></mtd><mtd columnalign="center" style="text-align: center"><msub><mi>d</mi><mn>11</mn></msub></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><mi>v</mi></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mi>w</mi></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow><mo>=</mo><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><msub><mi>d</mi><mn>20</mn></msub></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><msub><mi>d</mi><mn>21</mn></msub></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow></mrow><annotation encoding="application/x-tex">
\begin{pmatrix} d_{00}&amp;d_{01}\\\ d_{01}&amp;d_{11} \end{pmatrix} \begin{pmatrix}v\\w\end{pmatrix} = \begin{pmatrix}d_{20}\\d_{21}\end{pmatrix}
</annotation></semantics></math>