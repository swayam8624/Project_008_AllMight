<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">each recursive call partitions a primitive set</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">into two spatially more coherent subsets</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">until leaf criteria are reached</mtext><mi>.</mi></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{each recursive call partitions a primitive set}\\\text{into two spatially more coherent subsets}\\\text{until leaf criteria are reached}.\end{gathered}}</annotation></semantics></math>