<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mrow><mi mathvariant="normal">Var</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><msub><mi>W</mi><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mfrac><mn>2</mn><mtext mathvariant="normal">fan_in</mtext></mfrac><mo>,</mo><mspace width="1.0em"></mspace><mrow><mtext mathvariant="normal">so standard deviation is </mtext><mspace width="0.333em"></mspace></mrow><msqrt><mfrac><mn>2</mn><mtext mathvariant="normal">fan_in</mtext></mfrac></msqrt><mi>.</mi></mrow><annotation encoding="application/x-tex">\operatorname{Var}(W_{ij})=\frac{2}{\text{fan\_in}}, \quad\text{so standard deviation is }\sqrt{\frac{2}{\text{fan\_in}}}.</annotation></semantics></math>