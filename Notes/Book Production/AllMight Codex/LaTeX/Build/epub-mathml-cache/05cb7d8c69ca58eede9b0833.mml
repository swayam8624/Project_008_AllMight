<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false" form="prefix">(</mo><mi>θ</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mi>a</mi><msup><mi>e</mi><mrow><mi>b</mi><msub><mi>x</mi><mi>i</mi></msub></mrow></msup><mo>+</mo><mi>c</mi><mo>−</mo><msub><mi>y</mi><mi>i</mi></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">r_i(\theta)=a e^{bx_i}+c-y_i.</annotation></semantics></math>