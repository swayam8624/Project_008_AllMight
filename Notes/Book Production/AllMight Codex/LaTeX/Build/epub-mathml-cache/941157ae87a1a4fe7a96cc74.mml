<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>d</mi><msub><mi>f</mi><mi>q</mi></msub><mo stretchy="false" form="prefix">(</mo><mi>δ</mi><mi>q</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><mn>1</mn></mtd><mtd columnalign="center" style="text-align: center"><mn>2</mn></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow><mi>A</mi><mspace width="0.167em"></mspace><mi>δ</mi><mi>q</mi><mo>=</mo><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><mn>2</mn></mtd><mtd columnalign="center" style="text-align: center"><mn>7</mn></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow><mi>δ</mi><mi>q</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">df_q(\delta q)=\begin{pmatrix}1&amp;2\end{pmatrix}A\,\delta q
=\begin{pmatrix}2&amp;7\end{pmatrix}\delta q.</annotation></semantics></math>