<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mn>6</mn><mo stretchy="false" form="prefix">(</mo><mn>3</mn><mo>⋅</mo><mn>5</mn><mo>⋅</mo><mn>5</mn><mo>+</mo><mn>1</mn><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mn>6</mn><mo stretchy="false" form="prefix">(</mo><mn>76</mn><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mn>456</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">6(3\cdot5\cdot5+1)=6(76)=456.</annotation></semantics></math>