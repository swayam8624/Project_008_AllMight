<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false" form="prefix">(</mo><mi>M</mi><mo>+</mo><mi>t</mi><mi>K</mi><mo stretchy="false" form="postfix">)</mo><mi>u</mi><mo>=</mo><mi>M</mi><msub><mi>u</mi><mn>0</mn></msub><mo>,</mo><mspace width="2.0em"></mspace><mi>t</mi><mo>&gt;</mo><mn>0</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">(M+tK)u=M u_0,\qquad t&gt;0.</annotation></semantics></math>