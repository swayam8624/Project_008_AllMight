<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">one material may contain multiple</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">physically meaningful reflection lobes</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">with different roughness distributions</mtext><mi>.</mi></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{one material may contain multiple}\\\text{physically meaningful reflection lobes}\\\text{with different roughness distributions}.\end{gathered}}</annotation></semantics></math>