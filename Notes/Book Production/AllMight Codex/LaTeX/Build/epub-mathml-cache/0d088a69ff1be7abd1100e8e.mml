<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">a carefully constructed sequence of random variables</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">whose expectation equals the rendering equation.</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{a carefully constructed sequence of random variables}\\\text{whose expectation equals the rendering equation.}\end{gathered}}</annotation></semantics></math>