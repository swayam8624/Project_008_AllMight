<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>x</mi><mi>L</mi></msub><mo stretchy="false" form="prefix">(</mo><mi>y</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mi>y</mi><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>7</mn><mn>16</mn></mfrac></mstyle><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>x</mi><mi>R</mi></msub><mo stretchy="false" form="prefix">(</mo><mi>y</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mstyle displaystyle="false"><mfrac><mn>23</mn><mn>16</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mi>y</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">x_L(y)=\tfrac34y-\tfrac7{16},\qquad
x_R(y)=\tfrac{23}{16}-\tfrac34y.</annotation></semantics></math>