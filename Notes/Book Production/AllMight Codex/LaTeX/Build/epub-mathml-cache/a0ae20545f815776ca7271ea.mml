<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false" form="prefix">|</mo><mi mathvariant="bold-italic">𝒑</mi><mo>+</mo><mi>t</mi><mi mathvariant="bold-italic">𝒗</mi><mo stretchy="false" form="prefix">|</mo><mn>2</mn><mo>=</mo><mo stretchy="false" form="prefix">(</mo><msub><mi>r</mi><mi>A</mi></msub><mo>+</mo><msub><mi>r</mi><mi>B</mi></msub><mo stretchy="false" form="postfix">)</mo><mn>2</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">|\mathbf p+t\mathbf v|2=(r_A+r_B)2.</annotation></semantics></math>