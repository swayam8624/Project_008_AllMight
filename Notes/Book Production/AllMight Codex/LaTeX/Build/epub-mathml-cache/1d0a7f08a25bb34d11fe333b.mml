<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mo stretchy="false" form="postfix">∥</mo><mi>A</mi><mi>x</mi><mo>−</mo><mi>b</mi><msubsup><mo stretchy="false" form="postfix">∥</mo><mn>2</mn><mn>2</mn></msubsup><mo>=</mo><msubsup><mrow><mo stretchy="true" form="prefix">∥</mo><mi>R</mi><mo stretchy="false" form="prefix">(</mo><msup><mi>P</mi><mi>T</mi></msup><mi>x</mi><mo stretchy="false" form="postfix">)</mo><mo>−</mo><mo stretchy="false" form="prefix">(</mo><msup><mi>Q</mi><mi>T</mi></msup><mi>b</mi><msub><mo stretchy="false" form="postfix">)</mo><mrow><mn>1</mn><mo>:</mo><mi>n</mi></mrow></msub><mo stretchy="true" form="postfix">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="true" form="prefix">∥</mo><mo stretchy="false" form="prefix">(</mo><msup><mi>Q</mi><mi>T</mi></msup><mi>b</mi><msub><mo stretchy="false" form="postfix">)</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn><mo>:</mo><mi>m</mi></mrow></msub><mo stretchy="true" form="postfix">∥</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mi>.</mi></mrow><annotation encoding="application/x-tex">\|Ax-b\|_2^2=
 \left\|R(P^Tx)-(Q^Tb)_{1:n}\right\|_2^2+
 \left\|(Q^Tb)_{n+1:m}\right\|_2^2 .</annotation></semantics></math>