<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">construct a cheaper representation that preserves enough truth</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">to reject or postpone expensive computation.</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{construct a cheaper representation that preserves enough truth}\\\text{to reject or postpone expensive computation.}\end{gathered}}</annotation></semantics></math>