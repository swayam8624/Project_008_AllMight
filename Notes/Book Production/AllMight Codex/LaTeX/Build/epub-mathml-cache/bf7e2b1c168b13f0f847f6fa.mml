<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>x</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>x</mi><mi>n</mi></msub><mo>−</mo><mo stretchy="false" form="prefix">(</mo><msubsup><mi>x</mi><mi>n</mi><mn>3</mn></msubsup><mo>−</mo><mn>2</mn><mo stretchy="false" form="postfix">)</mo><mi>/</mi><mo stretchy="false" form="prefix">(</mo><mn>3</mn><msubsup><mi>x</mi><mi>n</mi><mn>2</mn></msubsup><mo stretchy="false" form="postfix">)</mo></mrow><annotation encoding="application/x-tex">x_{n+1}=x_n-(x_n^3-2)/(3x_n^2)</annotation></semantics></math>