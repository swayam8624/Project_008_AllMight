<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">pixel sample</mtext><mo>→</mo><mtext mathvariant="normal">camera ray</mtext><mo>→</mo><mtext mathvariant="normal">BVH</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">surface</mtext><mo>→</mo><mtext mathvariant="normal">emission/NEE</mtext><mo>→</mo><mtext mathvariant="normal">BSDF sample</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mfrac><mrow><mi>f</mi><mi mathvariant="normal">cos</mi></mrow><mi>p</mi></mfrac><mo>→</mo><mtext mathvariant="normal">MIS</mtext><mo>→</mo><mtext mathvariant="normal">medium transition</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">roulette</mtext><mo>→</mo><mtext mathvariant="normal">next bounce</mtext><mo>→</mo><mtext mathvariant="normal">linear film</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">HDR/tone mapping</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{gathered}\text{pixel sample}\rightarrow\text{camera ray}\rightarrow\text{BVH}\\\rightarrow\text{surface}\rightarrow\text{emission/NEE}\rightarrow\text{BSDF sample}\\\rightarrow\frac{f\cos}{p}\rightarrow\text{MIS}\rightarrow\text{medium transition}\\\rightarrow\text{roulette}\rightarrow\text{next bounce}\rightarrow\text{linear film}\\\rightarrow\text{HDR/tone mapping}.\end{gathered}</annotation></semantics></math>