<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">estimate distribution or parameter</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">plug in unknown quantities</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">plug in unknown quantities</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">linearize the requested transformation</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">linearize the requested transformation</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">propagate uncertainty</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{estimate distribution or parameter} &amp;\rightarrow \text{plug in unknown quantities}\\\text{plug in unknown quantities} &amp;\rightarrow \text{linearize the requested transformation}\\\text{linearize the requested transformation} &amp;\rightarrow \text{propagate uncertainty}.\end{aligned}</annotation></semantics></math>