<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mn>1</mn>
  <mrow data-mjx-texclass="ORD">
    <mo>/</mo>
  </mrow>
  <mrow data-mjx-texclass="ORD">
    <mrow data-mjx-texclass="OPEN">
      <mo minsize="1.2em" maxsize="1.2em">(</mo>
    </mrow>
    <mfrac linethickness="0">
      <mn>4</mn>
      <mn>2</mn>
    </mfrac>
    <mrow data-mjx-texclass="CLOSE">
      <mo minsize="1.2em" maxsize="1.2em">)</mo>
    </mrow>
  </mrow>
</math>