<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>y</mi><mi>N</mi></msub><mo>=</mo><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><mn>1</mn><mi>/</mi><mi>N</mi><msup><mo stretchy="false" form="postfix">)</mo><mi>N</mi></msup></mrow><annotation encoding="application/x-tex">y_N=(1-1/N)^N</annotation></semantics></math>