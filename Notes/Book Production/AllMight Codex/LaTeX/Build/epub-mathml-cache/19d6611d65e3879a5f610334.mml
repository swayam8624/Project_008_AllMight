<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">Δ</mi><msub><mi>v</mi><mi>n</mi></msub><mo>=</mo><msub><mi>k</mi><mi>n</mi></msub><mi>λ</mi><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>k</mi><mi>n</mi></msub><mo>=</mo><msub><mi>m</mi><mi>A</mi></msub><mrow><mi>−</mi><mn>1</mn></mrow><mo>+</mo><msub><mi>m</mi><mi>B</mi></msub><mrow><mi>−</mi><mn>1</mn></mrow><mo>+</mo><msubsup><mi>I</mi><mi>A</mi><mrow><mi>−</mi><mn>1</mn></mrow></msubsup><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒓</mi><mi>A</mi></msub><mo>×</mo><mi mathvariant="bold-italic">𝒏</mi><msup><mo stretchy="false" form="postfix">)</mo><mn>2</mn></msup><mo>+</mo><msubsup><mi>I</mi><mi>B</mi><mrow><mi>−</mi><mn>1</mn></mrow></msubsup><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒓</mi><mi>B</mi></msub><mo>×</mo><mi mathvariant="bold-italic">𝒏</mi><msup><mo stretchy="false" form="postfix">)</mo><mn>2</mn></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">\Delta v_n=k_n\lambda,\qquad k_n=m_A{-1}+m_B{-1} +I_A^{-1}(\mathbf r_A\times\mathbf n)^2 +I_B^{-1}(\mathbf r_B\times\mathbf n)^2.</annotation></semantics></math>