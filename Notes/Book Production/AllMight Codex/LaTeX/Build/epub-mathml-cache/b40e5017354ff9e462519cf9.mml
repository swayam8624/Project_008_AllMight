<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="bold-italic">𝒊</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒏</mi><mo>=</mo><mi>−</mi><mn>1</mn><mi>/</mi><msqrt><mn>2</mn></msqrt></mrow><annotation encoding="application/x-tex">\mathbf i\cdot\mathbf n=-1/\sqrt2</annotation></semantics></math>