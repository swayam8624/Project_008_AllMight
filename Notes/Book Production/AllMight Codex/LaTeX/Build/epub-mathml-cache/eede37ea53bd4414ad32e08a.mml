<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>x</mi><mo>=</mo><mn>2</mn><mi>s</mi><mspace width="0.222em"></mspace><mi mathvariant="normal">m</mi><mo>,</mo><mspace width="2.0em"></mspace><mi>y</mi><mo>=</mo><mn>3</mn><mi>t</mi><mspace width="0.222em"></mspace><mi mathvariant="normal">m</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">x=2s\ \mathrm m,\qquad y=3t\ \mathrm m.</annotation></semantics></math>