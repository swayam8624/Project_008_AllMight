<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>κ</mi><mn>2</mn></msub><mo stretchy="false" form="prefix">(</mo><msub><mi>A</mi><mi>δ</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msqrt><mfrac><msub><mi>λ</mi><mi mathvariant="normal">max</mi></msub><msub><mi>λ</mi><mi mathvariant="normal">min</mi></msub></mfrac></msqrt><mo>=</mo><mfrac><msub><mi>λ</mi><mi mathvariant="normal">max</mi></msub><mi>δ</mi></mfrac><mo>∼</mo><mfrac><mn>4</mn><mi>δ</mi></mfrac><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>κ</mi><mn>2</mn></msub><mo stretchy="false" form="prefix">(</mo><msubsup><mi>A</mi><mi>δ</mi><mi>T</mi></msubsup><msub><mi>A</mi><mi>δ</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msub><mi>κ</mi><mn>2</mn></msub><mo stretchy="false" form="prefix">(</mo><msub><mi>A</mi><mi>δ</mi></msub><msup><mo stretchy="false" form="postfix">)</mo><mn>2</mn></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">\kappa_2(A_\delta)
=\sqrt{\frac{\lambda_{\max}}{\lambda_{\min}}}
=\frac{\lambda_{\max}}{\delta}
\sim\frac4\delta,\qquad
\kappa_2(A_\delta^TA_\delta)=\kappa_2(A_\delta)^2.</annotation></semantics></math>