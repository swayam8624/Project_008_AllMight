<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>S</mi><mo>=</mo><munder><mo>∑</mo><mi>i</mi></munder><mo stretchy="false" form="prefix">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo>−</mo><mover><mi>p</mi><mo accent="true">‾</mo></mover><mo stretchy="false" form="postfix">)</mo><mo stretchy="false" form="prefix">(</mo><msub><mi>p</mi><mi>i</mi></msub><mo>−</mo><mover><mi>p</mi><mo accent="true">‾</mo></mover><msup><mo stretchy="false" form="postfix">)</mo><mi>T</mi></msup><mo>=</mo><mrow><mo stretchy="true" form="prefix">[</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><msub><mi>S</mi><mrow><mi>x</mi><mi>x</mi></mrow></msub></mtd><mtd columnalign="center" style="text-align: center"><msub><mi>S</mi><mrow><mi>x</mi><mi>y</mi></mrow></msub></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><msub><mi>S</mi><mrow><mi>x</mi><mi>y</mi></mrow></msub></mtd><mtd columnalign="center" style="text-align: center"><msub><mi>S</mi><mrow><mi>y</mi><mi>y</mi></mrow></msub></mtd></mtr></mtable><mo stretchy="true" form="postfix">]</mo></mrow><mi>.</mi></mrow><annotation encoding="application/x-tex">S=\sum_i(p_i-\bar p)(p_i-\bar p)^T
 =\begin{bmatrix}S_{xx}&amp;S_{xy}\\S_{xy}&amp;S_{yy}\end{bmatrix}.</annotation></semantics></math>