<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>g</mi><mo stretchy="false" form="prefix">(</mo><mi>t</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mo stretchy="false" form="prefix">|</mo><mi mathvariant="bold-italic">𝒑</mi><mo>+</mo><mi>t</mi><mi mathvariant="bold-italic">𝒗</mi><mo stretchy="false" form="prefix">|</mo><mi>−</mi><mi>R</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">g(t)=|\mathbf p+t\mathbf v|-R.</annotation></semantics></math>