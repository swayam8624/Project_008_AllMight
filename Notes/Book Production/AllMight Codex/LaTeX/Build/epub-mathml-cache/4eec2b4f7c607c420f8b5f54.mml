<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>r</mi><mo stretchy="false" form="prefix">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mi>a</mi><mo>−</mo><mi>b</mi><mo>−</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">r(a,b)=a-b-d</annotation></semantics></math>