<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>a</mi><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mi>b</mi><mi>t</mi><mo>+</mo><mi>c</mi><mo>=</mo><mn>0</mn><mo>,</mo><mspace width="2.0em"></mspace><mi>a</mi><mo>=</mo><mi mathvariant="bold-italic">𝒗</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒗</mi><mo>,</mo><mspace width="1.0em"></mspace><mi>b</mi><mo>=</mo><mn>2</mn><mi mathvariant="bold-italic">𝒑</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒗</mi><mo>,</mo><mspace width="1.0em"></mspace><mi>c</mi><mo>=</mo><mi mathvariant="bold-italic">𝒑</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒑</mi><mo>−</mo><msup><mi>R</mi><mn>2</mn></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">at^2+bt+c=0,\qquad a=\mathbf v\cdot\mathbf v,\quad b=2\mathbf p\cdot\mathbf v,\quad c=\mathbf p\cdot\mathbf p-R^2.</annotation></semantics></math>