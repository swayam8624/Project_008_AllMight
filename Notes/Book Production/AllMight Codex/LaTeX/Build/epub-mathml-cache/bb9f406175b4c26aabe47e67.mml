<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>E</mi><mo stretchy="false" form="prefix">(</mo><mi>u</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mo>∫</mo><mi>T</mi></msub><msup><mrow><mo stretchy="true" form="prefix">‖</mo><mi>∇</mi><mi>u</mi><mo stretchy="true" form="postfix">‖</mo></mrow><mn>2</mn></msup><mspace width="0.167em"></mspace><mi>d</mi><mi>A</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>u</mi><mi>T</mi></msup><msub><mi>K</mi><mi>T</mi></msub><mi>u</mi><mo>,</mo><mspace width="2.0em"></mspace><mo stretchy="false" form="prefix">(</mo><msub><mi>K</mi><mi>T</mi></msub><msub><mo stretchy="false" form="postfix">)</mo><mrow><mi>i</mi><mi>j</mi></mrow></msub><mo>=</mo><mi>A</mi><mspace width="0.167em"></mspace><mi>∇</mi><msub><mi>ϕ</mi><mi>i</mi></msub><mo>⋅</mo><mi>∇</mi><msub><mi>ϕ</mi><mi>j</mi></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">E(u)=\frac12\int_T\lVert\nabla u\rVert^2\,dA
=\frac12u^TK_Tu,\qquad
(K_T)_{ij}=A\,\nabla\phi_i\cdot\nabla\phi_j.</annotation></semantics></math>