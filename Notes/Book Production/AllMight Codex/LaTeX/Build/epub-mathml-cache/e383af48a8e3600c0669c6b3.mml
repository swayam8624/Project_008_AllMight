<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi>RMSE</mi>
  <mo>=</mo>
  <msqrt>
    <mfrac>
      <mn>1</mn>
      <mi>N</mi>
    </mfrac>
    <munder>
      <mo data-mjx-texclass="OP">&#x2211;</mo>
      <mi>i</mi>
    </munder>
    <mo stretchy="false">(</mo>
    <msub>
      <mrow data-mjx-texclass="ORD">
        <mover>
          <mi>y</mi>
          <mo stretchy="false">^</mo>
        </mover>
      </mrow>
      <mi>i</mi>
    </msub>
    <mo>&#x2212;</mo>
    <msub>
      <mi>y</mi>
      <mi>i</mi>
    </msub>
    <msup>
      <mo stretchy="false">)</mo>
      <mn>2</mn>
    </msup>
  </msqrt>
</math>