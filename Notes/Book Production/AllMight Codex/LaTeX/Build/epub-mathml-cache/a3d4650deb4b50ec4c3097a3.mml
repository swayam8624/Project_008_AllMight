<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>F</mi><mo stretchy="false" form="prefix">(</mo><mi>t</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mo stretchy="false" form="prefix">|</mo><mi mathvariant="bold-italic">𝒑</mi><mo>+</mo><mi>t</mi><mi mathvariant="bold-italic">𝒗</mi><mo stretchy="false" form="prefix">|</mo><mn>2</mn><mo>−</mo><mi>R</mi><mn>2</mn><mo>=</mo><mo stretchy="false" form="prefix">(</mo><mi mathvariant="bold-italic">𝒗</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒗</mi><mo stretchy="false" form="postfix">)</mo><msup><mi>t</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mo stretchy="false" form="prefix">(</mo><mi mathvariant="bold-italic">𝒑</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒗</mi><mo stretchy="false" form="postfix">)</mo><mi>t</mi><mo>+</mo><mi mathvariant="bold-italic">𝒑</mi><mo>⋅</mo><mi mathvariant="bold-italic">𝒑</mi><mo>−</mo><msup><mi>R</mi><mn>2</mn></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">F(t)=|\mathbf p+t\mathbf v|2-R2 =(\mathbf v\cdot\mathbf v)t^2 +2(\mathbf p\cdot\mathbf v)t +\mathbf p\cdot\mathbf p-R^2.</annotation></semantics></math>