<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mo data-mjx-texclass="ORD" fence="false" stretchy="false">&#x2016;</mo>
  <mi>A</mi>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>v</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mo>&#x2212;</mo>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>&#x3BB;</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>v</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <msub>
    <mo data-mjx-texclass="ORD" fence="false" stretchy="false">&#x2016;</mo>
    <mn>2</mn>
  </msub>
  <mrow data-mjx-texclass="ORD">
