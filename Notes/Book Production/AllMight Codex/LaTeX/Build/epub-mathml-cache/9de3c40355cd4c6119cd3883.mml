<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>K</mi><mi>ϕ</mi><mo>=</mo><mi>b</mi><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>b</mi><mi>i</mi></msub><mo>=</mo><munder><mo>∑</mo><mrow><mi>T</mi><mo>∋</mo><mi>i</mi></mrow></munder><msub><mi>A</mi><mi>T</mi></msub><mspace width="0.167em"></mspace><mi>∇</mi><msub><mi>ϕ</mi><mi>i</mi></msub><mo>⋅</mo><msub><mi>X</mi><mi>T</mi></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">K\phi=b,\qquad
