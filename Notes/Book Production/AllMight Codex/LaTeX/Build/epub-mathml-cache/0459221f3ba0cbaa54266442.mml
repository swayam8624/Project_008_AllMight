<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>&#x3C9;</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mfrac>
    <mrow>
      <mo stretchy="false">|</mo>
      <mi>&#x3C9;</mi>
      <mrow data-mjx-texclass="ORD">
        <mo stretchy="false">|</mo>
      </mrow>
      <mi>d</mi>
      <mi>t</mi>
    </mrow>
    <mn>2</mn>
  </mfrac>
  <mo>=</mo>
  <mfrac>
    <mn>1</mn>
    <mn>2</mn>
  </mfrac>
  <mi>&#x3C9;</mi>
  <mi>d</mi>
  <mi>t</mi>
  <mo>.</mo>
</math>