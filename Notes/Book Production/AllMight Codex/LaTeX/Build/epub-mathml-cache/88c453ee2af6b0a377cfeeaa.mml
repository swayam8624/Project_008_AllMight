<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">dense explicit field</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>↔</mo><mtext mathvariant="normal">factorized explicit field</mtext><mo>↔</mo><mtext mathvariant="normal">hybrid encoded field</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">hybrid encoded field</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>↔</mo><mtext mathvariant="normal">implicit neural field</mtext><mo>↔</mo><mtext mathvariant="normal">explicit learned primitives</mtext><mo>,</mo></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{dense explicit field} &amp;\leftrightarrow \text{factorized explicit field} \leftrightarrow \text{hybrid encoded field} \\\text{hybrid encoded field} &amp;\leftrightarrow \text{implicit neural field} \leftrightarrow \text{explicit learned primitives},\end{aligned}</annotation></semantics></math>