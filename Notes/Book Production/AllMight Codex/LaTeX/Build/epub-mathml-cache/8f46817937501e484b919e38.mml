<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>m</mi>
  <msqrt>
    <mo stretchy="false">(</mo>
    <mi>x</mi>
    <mrow data-mjx-texclass="ORD">
      <mo>/</mo>
    </mrow>
    <mi>m</mi>
    <msup>
      <mo stretchy="false">)</mo>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <mo stretchy="false">(</mo>
    <mi>y</mi>
    <mrow data-mjx-texclass="ORD">
      <mo>/</mo>
    </mrow>
    <mi>m</mi>
    <msup>
      <mo stretchy="false">)</mo>
      <mn>2</mn>
    </msup>
  </msqrt>
</math>