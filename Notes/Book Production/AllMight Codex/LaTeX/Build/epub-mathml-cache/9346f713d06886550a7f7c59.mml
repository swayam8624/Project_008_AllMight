<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mover><mi>g</mi><mo accent="true">̇</mo></mover><mo stretchy="false" form="prefix">(</mo><mi>t</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mi mathvariant="bold-italic">𝒏</mi><mo stretchy="false" form="prefix">(</mo><mi>t</mi><mo stretchy="false" form="postfix">)</mo><mo>⋅</mo><mi mathvariant="bold-italic">𝒗</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">\dot g(t)=\mathbf n(t)\cdot\mathbf v.</annotation></semantics></math>