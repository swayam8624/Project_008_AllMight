<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msup><mi>P</mi><mo>′</mo></msup><mo>=</mo><mi>P</mi><mo>+</mo><msub><mn mathvariant="bold">𝟏</mn><mi>N</mi></msub><msup><mi>t</mi><mi>T</mi></msup></mrow><annotation encoding="application/x-tex">P&#39;=P+\mathbf1_Nt^T</annotation></semantics></math>