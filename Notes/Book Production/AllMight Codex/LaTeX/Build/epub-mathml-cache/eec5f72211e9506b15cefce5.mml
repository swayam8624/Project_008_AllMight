<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="bold-italic">𝒕</mi><mo>=</mo><mi>η</mi><mi mathvariant="bold-italic">𝒊</mi><mo>+</mo><mo stretchy="false" form="prefix">(</mo><mi>η</mi><msub><mi>c</mi><mi>i</mi></msub><mo>−</mo><msqrt><mi>k</mi></msqrt><mo stretchy="false" form="postfix">)</mo><mi mathvariant="bold-italic">𝒏</mi><mo>,</mo><mspace width="2.0em"></mspace><mi>k</mi><mo>=</mo><mn>1</mn><mo>−</mo><msup><mi>η</mi><mn>2</mn></msup><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><msubsup><mi>c</mi><mi>i</mi><mn>2</mn></msubsup><mo stretchy="false" form="postfix">)</mo><mi>.</mi></mrow><annotation encoding="application/x-tex">\mathbf t=\eta\mathbf i+(\eta c_i-\sqrt{k})\mathbf n,
\qquad k=1-\eta^2(1-c_i^2).</annotation></semantics></math>