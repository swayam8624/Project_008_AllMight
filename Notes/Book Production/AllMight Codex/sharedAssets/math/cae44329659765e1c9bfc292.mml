<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mtable displaystyle="true" columnalign="right left right left" columnspacing="0em 2em 0em" rowspacing="3pt">
            <mtr>
              <mtd></mtd>
              <mtd>
                <mtext>Where are commands stored?</mtext>
              </mtd>
              <mtd></mtd>
              <mtd>
                <mi></mi>
                <mo stretchy="false">&#x2192;</mo>
                <mtext>command allocator</mtext>
              </mtd>
            </mtr>
            <mtr>
              <mtd></mtd>
              <mtd>
                <mtext>What resources can shaders address?</mtext>
              </mtd>
              <mtd></mtd>
              <mtd>
                <mi></mi>
                <mo stretchy="false">&#x2192;</mo>
                <mtext>argument table</mtext>
              </mtd>
            </mtr>
            <mtr>
              <mtd></mtd>
              <mtd>
                <mtext>What resources must be GPU-visible?</mtext>
              </mtd>
              <mtd></mtd>
              <mtd>
                <mi></mi>
                <mo stretchy="false">&#x2192;</mo>
                <mtext>residency set</mtext>
              </mtd>
            </mtr>
            <mtr>
              <mtd></mtd>
              <mtd>
                <mtext>What earlier work must precede later work?</mtext>
              </mtd>
              <mtd></mtd>
              <mtd>
                <mi></mi>
                <mo stretchy="false">&#x2192;</mo>
                <mtext>barrier/dependency</mtext>
              </mtd>
            </mtr>
          </mtable>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
</math>