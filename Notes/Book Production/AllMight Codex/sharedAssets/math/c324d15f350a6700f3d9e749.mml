<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <msub>
    <mi>p</mi>
    <mi>X</mi>
  </msub>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <msub>
    <mi>p</mi>
    <mi>U</mi>
  </msub>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">(</mo>
    <mfrac>
      <mrow>
        <mi>x</mi>
        <mo>&#x2212;</mo>
        <mi>a</mi>
      </mrow>
      <mrow>
        <mi>b</mi>
        <mo>&#x2212;</mo>
        <mi>a</mi>
      </mrow>
    </mfrac>
    <mo data-mjx-texclass="CLOSE">)</mo>
  </mrow>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">|</mo>
    <mfrac>
      <mn>1</mn>
      <mrow>
        <mi>b</mi>
        <mo>&#x2212;</mo>
        <mi>a</mi>
      </mrow>
    </mfrac>
    <mo data-mjx-texclass="CLOSE">|</mo>
  </mrow>
  <mo>.</mo>
</math>