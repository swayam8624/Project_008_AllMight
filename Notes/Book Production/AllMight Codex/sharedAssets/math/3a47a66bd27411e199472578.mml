<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>x</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mo>=</mo>
  <msub>
    <mi>P</mi>
    <mrow data-mjx-texclass="ORD">
      <mo data-mjx-texclass="OP" movablelimits="true">min</mo>
      <mo>,</mo>
      <mi>x</mi>
    </mrow>
  </msub>
  <mo>+</mo>
  <mfrac>
    <mi>q</mi>
    <mrow>
      <msup>
        <mn>2</mn>
        <mi>b</mi>
      </msup>
      <mo>&#x2212;</mo>
      <mn>1</mn>
    </mrow>
  </mfrac>
  <mo stretchy="false">(</mo>
  <msub>
    <mi>P</mi>
    <mrow data-mjx-texclass="ORD">
      <mo data-mjx-texclass="OP" movablelimits="true">max</mo>
      <mo>,</mo>
      <mi>x</mi>
    </mrow>
  </msub>
  <mo>&#x2212;</mo>
  <msub>
    <mi>P</mi>
    <mrow data-mjx-texclass="ORD">
      <mo data-mjx-texclass="OP" movablelimits="true">min</mo>
      <mo>,</mo>
      <mi>x</mi>
    </mrow>
  </msub>
  <mo stretchy="false">)</mo>
  <mo>.</mo>
</math>