<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mfrac>
            <mi>d</mi>
            <mrow>
              <mi>d</mi>
              <mi>x</mi>
            </mrow>
          </mfrac>
          <mi>arccos</mi>
          <mo data-mjx-texclass="NONE">&#x2061;</mo>
          <mi>x</mi>
          <mo>=</mo>
          <mo>&#x2212;</mo>
          <mfrac>
            <mn>1</mn>
            <msqrt>
              <mn>1</mn>
              <mo>&#x2212;</mo>
              <msup>
                <mi>x</mi>
                <mn>2</mn>
              </msup>
            </msqrt>
          </mfrac>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
