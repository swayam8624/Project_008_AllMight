<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi>E</mi>
  <mo stretchy="false">(</mo>
  <mi>x</mi>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mfrac>
    <mn>1</mn>
    <mi>&#x3C0;</mi>
  </mfrac>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">[</mo>
    <mi>arccos</mi>
    <mo data-mjx-texclass="NONE">&#x2061;</mo>
    <mrow data-mjx-texclass="INNER">
      <mo data-mjx-texclass="OPEN">(</mo>
      <mo>&#x2212;</mo>
      <mfrac>
        <mi>x</mi>
        <mi>R</mi>
      </mfrac>
      <mo data-mjx-texclass="CLOSE">)</mo>
    </mrow>
    <mo>+</mo>
    <mfrac>
      <mi>x</mi>
      <mi>R</mi>
    </mfrac>
    <msqrt>
      <mn>1</mn>
      <mo>&#x2212;</mo>
      <mfrac>
        <msup>
          <mi>x</mi>
          <mn>2</mn>
        </msup>
        <msup>
          <mi>R</mi>
          <mn>2</mn>
        </msup>
      </mfrac>
    </msqrt>
    <mo data-mjx-texclass="CLOSE">]</mo>
  </mrow>
  <mo>.</mo>
</math>