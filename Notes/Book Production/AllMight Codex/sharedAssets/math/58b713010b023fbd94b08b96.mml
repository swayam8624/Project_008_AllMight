<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <msub>
    <mrow data-mjx-texclass="ORD">
      <mover>
        <mi>x</mi>
        <mo stretchy="false">^</mo>
      </mover>
    </mrow>
    <mrow data-mjx-texclass="ORD">
      <mi>t</mi>
      <mo>,</mo>
      <mi>i</mi>
    </mrow>
  </msub>
  <mo>=</mo>
  <mfrac>
    <mrow>
      <mrow data-mjx-texclass="ORD">
        <mn mathvariant="bold">1</mn>
      </mrow>
      <mo fence="false" stretchy="false">{</mo>
      <msub>
        <mi>A</mi>
        <mi>t</mi>
      </msub>
      <mo>=</mo>
      <mi>i</mi>
      <mo fence="false" stretchy="false">}</mo>
      <msub>
        <mi>X</mi>
        <mi>t</mi>
      </msub>
    </mrow>
    <msub>
      <mi>P</mi>
      <mrow data-mjx-texclass="ORD">
        <mi>t</mi>
        <mo>,</mo>
        <mi>i</mi>
      </mrow>
    </msub>
  </mfrac>
  <mo>.</mo>
</math>