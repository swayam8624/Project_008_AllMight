              <mo>&#x2212;</mo>
              <mn>1</mn>
            </mrow>
          </msup>
          <mi mathvariant="bold-italic">F</mi>
          <mo stretchy="false">(</mo>
          <mi mathvariant="bold-italic">x</mi>
          <mo>,</mo>
          <mi mathvariant="bold-italic">v</mi>
          <mo>,</mo>
          <mi>t</mi>
          <mo stretchy="false">)</mo>
        </mtd>
      </mtr>
    </mtable>
    <mo data-mjx-texclass="CLOSE">]</mo>
  </mrow>
  <mo>=</mo>
  <mi mathvariant="bold-italic">f</mi>
  <mo stretchy="false">(</mo>
  <mi mathvariant="bold-italic">z</mi>
  <mo>,</mo>
  <mi>t</mi>
  <mo stretchy="false">)</mo>
