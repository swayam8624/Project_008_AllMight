<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <msqrt>
    <msup>
      <mi>x</mi>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <msup>
      <mi>y</mi>
      <mn>2</mn>
    </msup>
  </msqrt>
  <mo>=</mo>
  <mi>m</mi>
  <msqrt>
    <msup>
      <mrow data-mjx-texclass="INNER">
        <mo data-mjx-texclass="OPEN">(</mo>
        <mfrac>
          <mi>x</mi>
          <mi>m</mi>
        </mfrac>
        <mo data-mjx-texclass="CLOSE">)</mo>
      </mrow>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <msup>
      <mrow data-mjx-texclass="INNER">
        <mo data-mjx-texclass="OPEN">(</mo>
        <mfrac>
          <mi>y</mi>
          <mi>m</mi>
        </mfrac>
        <mo data-mjx-texclass="CLOSE">)</mo>
      </mrow>
      <mn>2</mn>
    </msup>
  </msqrt>
  <mo>.</mo>
</math>