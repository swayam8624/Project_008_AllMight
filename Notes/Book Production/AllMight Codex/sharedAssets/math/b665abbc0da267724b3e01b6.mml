<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mi>&#x3D5;</mi>
          <mo stretchy="false">(</mo>
          <mi>z</mi>
          <mo stretchy="false">)</mo>
          <mo>=</mo>
          <mfrac>
            <mn>1</mn>
            <msqrt>
              <mn>2</mn>
              <mi>&#x3C0;</mi>
            </msqrt>
          </mfrac>
          <msup>
            <mi>e</mi>
            <mrow data-mjx-texclass="ORD">
              <mo>&#x2212;</mo>
              <msup>
                <mi>z</mi>
                <mn>2</mn>
              </msup>
              <mrow data-mjx-texclass="ORD">
                <mo>/</mo>
              </mrow>
              <mn>2</mn>
            </mrow>
          </msup>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
</math>