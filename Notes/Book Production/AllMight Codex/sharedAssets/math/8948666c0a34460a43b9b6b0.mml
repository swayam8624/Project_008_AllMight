<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <munder>
    <mo data-mjx-texclass="OP" movablelimits="true">max</mo>
    <mrow data-mjx-texclass="ORD">
      <mi>&#x3D1;</mi>
      <mo>&#x2208;</mo>
      <mrow data-mjx-texclass="ORD">
        <mi data-mjx-variant="-tex-calligraphic" mathvariant="script">C</mi>
      </mrow>
    </mrow>
  </munder>
  <msup>
    <mi>a</mi>
    <mrow data-mjx-texclass="ORD">
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="sans-serif">T</mi>
      </mrow>
    </mrow>
  </msup>
  <mi>&#x3D1;</mi>
  <mo>=</mo>
  <msup>
    <mi>a</mi>
    <mrow data-mjx-texclass="ORD">
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="sans-serif">T</mi>
      </mrow>
    </mrow>
  </msup>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>&#x3B8;</mi>
      <mo>^</mo>
    </mover>
  </mrow>
  <mo>+</mo>
  <mi>r</mi>
  <msqrt>
    <msup>
      <mi>a</mi>
      <mrow data-mjx-texclass="ORD">
        <mrow data-mjx-texclass="ORD">
          <mi mathvariant="sans-serif">T</mi>
        </mrow>
      </mrow>
    </msup>
    <msup>
      <mi>V</mi>
      <mrow data-mjx-texclass="ORD">
        <mo>&#x2212;</mo>
        <mn>1</mn>
      </mrow>
    </msup>
    <mi>a</mi>
  </msqrt>
  <mo>.</mo>
</math>