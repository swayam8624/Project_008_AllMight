<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mi>I</mi>
  <mo>+</mo>
  <mi>&#x3B8;</mi>
  <mo stretchy="false">[</mo>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="bold">a</mi>
      </mrow>
      <mo>^</mo>
    </mover>
  </mrow>
  <msub>
    <mo stretchy="false">]</mo>
    <mo>&#xD7;</mo>
  </msub>
  <mo>+</mo>
  <mi>O</mi>
  <mo stretchy="false">(</mo>
  <msup>
    <mi>&#x3B8;</mi>
    <mn>2</mn>
  </msup>
  <mo stretchy="false">)</mo>
</math>