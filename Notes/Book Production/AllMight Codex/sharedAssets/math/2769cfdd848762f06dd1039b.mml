<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics>
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <msub>
            <mi>S</mi>
            <mi>N</mi>
          </msub>
          <mo>=</mo>
          <mfrac>
            <mi>h</mi>
            <mn>3</mn>
          </mfrac>
          <mrow data-mjx-texclass="INNER">
            <mo data-mjx-texclass="OPEN">[</mo>
            <msub>
              <mi>f</mi>
              <mn>0</mn>
            </msub>
            <mo>+</mo>
            <msub>
              <mi>f</mi>
              <mi>N</mi>
            </msub>
            <mo>+</mo>
            <mn>4</mn>
            <munderover>
              <mo data-mjx-texclass="OP">∑</mo>
              <mrow data-mjx-texclass="ORD">
                <mtable data-mjx-smallmatrix="true" columnspacing="0em" rowspacing="0.1em">
                  <mtr>
                    <mtd>
                      <mi>i</mi>
                      <mo>=</mo>
                      <mn>1</mn>
                    </mtd>
                  </mtr>
                  <mtr>
                    <mtd>
                      <mi>i</mi>
                      <mtext> odd</mtext>
                    </mtd>
                  </mtr>
                </mtable>
              </mrow>
              <mrow data-mjx-texclass="ORD">
                <mi>N</mi>
                <mo>−</mo>
                <mn>1</mn>
              </mrow>
            </munderover>
            <msub>
              <mi>f</mi>
              <mi>i</mi>
            </msub>
            <mo>+</mo>
            <mn>2</mn>
            <munderover>
              <mo data-mjx-texclass="OP">∑</mo>
              <mrow data-mjx-texclass="ORD">
                <mtable data-mjx-smallmatrix="true" columnspacing="0em" rowspacing="0.1em">
                  <mtr>
                    <mtd>
                      <mi>i</mi>
                      <mo>=</mo>
                      <mn>2</mn>
                    </mtd>
                  </mtr>
                  <mtr>
                    <mtd>
                      <mi>i</mi>
                      <mtext> even</mtext>
                    </mtd>
                  </mtr>
                </mtable>
              </mrow>
              <mrow data-mjx-texclass="ORD">
                <mi>N</mi>
                <mo>−</mo>
                <mn>2</mn>
              </mrow>
            </munderover>
            <msub>
              <mi>f</mi>
              <mi>i</mi>
            </msub>
            <mo data-mjx-texclass="CLOSE">]</mo>
