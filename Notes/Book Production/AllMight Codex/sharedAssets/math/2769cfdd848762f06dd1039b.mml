    </mrow>
  </menclose>
  <mo>.</mo>
<annotation encoding="application/x-tex">
\boxed{ S_N= \frac h3 \left[ f_0+f_N+ 4\sum_{\substack{i=1\\\i\text{ odd}}}^{N-1}f_i+ 2\sum_{\substack{i=2\\\i\text{ even}}}^{N-2}f_i \right] }.
</annotation></semantics></math>