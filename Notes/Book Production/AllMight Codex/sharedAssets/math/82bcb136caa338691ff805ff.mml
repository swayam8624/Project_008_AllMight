<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt">
    <mtr>
      <mtd>
        <mtext>Laplace:</mtext>
        <mstyle scriptlevel="0">
          <mspace width="1em"></mspace>
        </mstyle>
      </mtd>
      <mtd>
        <mi mathvariant="normal">&#x394;</mi>
        <mi>u</mi>
        <mo>=</mo>
        <mn>0</mn>
        <mo>,</mo>
      </mtd>
    </mtr>
    <mtr>
      <mtd>
        <mtext>Heat:</mtext>
        <mstyle scriptlevel="0">
          <mspace width="1em"></mspace>
        </mstyle>
      </mtd>
      <mtd>
        <msub>
          <mi>u</mi>
          <mi>t</mi>
        </msub>
        <mo>=</mo>
        <mi>&#x3BA;</mi>
        <mi mathvariant="normal">&#x394;</mi>
        <mi>u</mi>
        <mo>,</mo>
      </mtd>
    </mtr>
    <mtr>
      <mtd>
        <mtext>Wave:</mtext>
        <mstyle scriptlevel="0">
          <mspace width="1em"></mspace>
        </mstyle>
      </mtd>
      <mtd>
        <msub>
          <mi>u</mi>
          <mrow data-mjx-texclass="ORD">
            <mi>t</mi>
            <mi>t</mi>
          </mrow>
        </msub>
        <mo>=</mo>
        <msup>
          <mi>c</mi>
          <mn>2</mn>
        </msup>
        <mi mathvariant="normal">&#x394;</mi>
        <mi>u</mi>
        <mo>.</mo>
      </mtd>
    </mtr>
  </mtable>
</math>