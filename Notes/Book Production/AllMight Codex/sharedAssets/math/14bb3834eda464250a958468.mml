  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mfrac>
            <mn>1</mn>
            <mn>2</mn>
          </mfrac>
          <mrow data-mjx-texclass="INNER">
            <mo data-mjx-texclass="OPEN">(</mo>
            <msub>
              <mi>f</mi>
              <mrow data-mjx-texclass="ORD">
                <mi>x</mi>
                <mi>x</mi>
              </mrow>
            </msub>
            <msubsup>
              <mi>h</mi>
              <mi>x</mi>
              <mn>2</mn>
            </msubsup>
            <mo>+</mo>
            <mn>2</mn>
            <msub>
              <mi>f</mi>
              <mrow data-mjx-texclass="ORD">
                <mi>x</mi>
                <mi>y</mi>
              </mrow>
            </msub>
            <msub>
              <mi>h</mi>
              <mi>x</mi>
