<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mfrac>
    <mrow>
      <mi>d</mi>
      <mo stretchy="false">(</mo>
      <mi>m</mi>
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="bold">v</mi>
      </mrow>
      <mo stretchy="false">)</mo>
    </mrow>
    <mrow>
      <mi>d</mi>
      <mi>t</mi>
    </mrow>
  </mfrac>
  <mo>=</mo>
  <mi>m</mi>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="bold">v</mi>
      </mrow>
      <mo>&#x2D9;</mo>
    </mover>
  </mrow>
  <mo>+</mo>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>m</mi>
      <mo>&#x2D9;</mo>
    </mover>
  </mrow>
  <mrow data-mjx-texclass="ORD">
    <mi mathvariant="bold">v</mi>
  </mrow>
  <mo>.</mo>
</math>