\def\AllMightCurrentStageNumber{0}
\def\AllMightCurrentStageTitle{}
\newcommand{\AllMightStageColor}[1]{% semantic accent by learning-stage number
  \ifcase#1 AMAccent\or AMStageOne\or AMStageTwo\or AMStageThree\or AMStageFour\or AMStageFive\or AMStageSix\or AMStageSeven\else AMAccent\fi}
\newcommand{\AllMightStageWash}[1]{%
  \ifcase#1 AMWash\or AMStageOneWash\or AMStageTwoWash\or AMStageThreeWash\or AMStageFourWash\or AMStageFiveWash\or AMStageSixWash\or AMStageSevenWash\else AMWash\fi}
\NewDocumentCommand{\AllMightStageMark}{m m}{\begingroup\color{\AllMightStageColor{#1}}\textsf{\bfseries STAGE~#1}\enspace\textcolor{AMMuted}{#2}\endgroup}
% Set the active volume accent and retain the human-readable stage metadata.
\NewDocumentCommand{\SetBookStage}{m m}{%
  \colorlet{AMBookAccent}{\AllMightStageColor{#1}}%
  \gdef\AllMightCurrentStageNumber{#1}%
  \gdef\AllMightCurrentStageTitle{#2}%
}
\newcommand{\BookStageHeading}{%
  \ifnum\AllMightCurrentStageNumber>0
    \AllMightStageMark{\AllMightCurrentStageNumber}{\AllMightCurrentStageTitle}%
  \fi}
