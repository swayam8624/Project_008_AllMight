% Font fallbacks preserve source sub/superscript semantics across the installed
% Pagella text/math and Menlo code faces; verbatim retains original code tokens.
\makeatletter
\newcommand{\AllMightDeclareUnicodeFallback}[2]{%
  \begingroup\lccode`\~=#1\relax
  \lowercase{\endgroup\protected\def~}{#2}}
\newcommand{\AllMightDeclareUnicodeSubscript}[2]{%
  \AllMightDeclareUnicodeFallback{#1}{\ifmmode_{#2}\else\textsubscript{#2}\fi}}
\newcommand{\AllMightDeclareUnicodeSuperscript}[2]{%
  \AllMightDeclareUnicodeFallback{#1}{\ifmmode^{#2}\else\textsuperscript{#2}\fi}}
\makeatother
