  local roots = {"Assets/Fonts/", "../Assets/Fonts/", "../../Assets/Fonts/", "../../../../Assets/Fonts/"}
  local found = false
  for _, root in ipairs(roots) do
    if lfs.attributes(root .. "NotoEmoji-Static.ttf") then
      tex.sprint(string.char(92) .. "newfontfamily" .. string.char(92) .. "AllMightEmojiFont{Noto Emoji}[Path=" .. root .. ",Extension=.ttf,UprightFont=NotoEmoji-Static,Scale=MatchLowercase]")
      found = true
      break
    end
  end
  if not found then tex.sprint(string.char(92) .. "PackageError{allmight-book}{Noto Emoji font asset not found}{Provide Assets/Fonts/NotoEmoji-Static.ttf next to this package.}") end
}
