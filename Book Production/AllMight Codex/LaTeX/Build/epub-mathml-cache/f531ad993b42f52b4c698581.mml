<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mover><mi>I</mi><mo accent="true">̂</mo></mover><mrow><mi mathvariant="normal">b</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">l</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">n</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></msub><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>n</mi></mrow></mfrac><mrow><mo stretchy="true" form="prefix">[</mo><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><msup><mi>e</mi><msub><mi>X</mi><mi>i</mi></msub></msup><mrow><mi>m</mi><mo stretchy="false" form="prefix">(</mo><msub><mi>X</mi><mi>i</mi></msub><mo stretchy="false" form="postfix">)</mo></mrow></mfrac><mo>+</mo><munderover><mo>∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><msup><mi>e</mi><msub><mi>Y</mi><mi>j</mi></msub></msup><mrow><mi>m</mi><mo stretchy="false" form="prefix">(</mo><msub><mi>Y</mi><mi>j</mi></msub><mo stretchy="false" form="postfix">)</mo></mrow></mfrac><mo stretchy="true" form="postfix">]</mo></mrow><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>X</mi><mi>i</mi></msub><mo>∼</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mspace width="1.0em"></mspace><msub><mi>Y</mi><mi>j</mi></msub><mo>∼</mo><msub><mi>p</mi><mn>2</mn></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">\widehat I_{\mathrm{balance}}
=\frac1{2n}\left[
\sum_{i=1}^n\frac{e^{X_i}}{m(X_i)}
+\sum_{j=1}^n\frac{e^{Y_j}}{m(Y_j)}
\right],\qquad
X_i\sim p_1,\quad Y_j\sim p_2.</annotation></semantics></math>