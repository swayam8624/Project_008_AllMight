<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">camera</mtext><mo>→</mo><mtext mathvariant="normal">closest hit</mtext><mo>→</mo><mtext mathvariant="normal">emission</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">NEE</mtext><mo>→</mo><mtext mathvariant="normal">BSDF event</mtext><mo>→</mo><mtext mathvariant="normal">throughput</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">medium update</mtext><mo>→</mo><mtext mathvariant="normal">roulette</mtext><mo>→</mo><mtext mathvariant="normal">next ray</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{gathered}\text{camera}\rightarrow\text{closest hit}\rightarrow\text{emission}\\\rightarrow\text{NEE}\rightarrow\text{BSDF event}\rightarrow\text{throughput}\\\rightarrow\text{medium update}\rightarrow\text{roulette}\rightarrow\text{next ray}.\end{gathered}</annotation></semantics></math>