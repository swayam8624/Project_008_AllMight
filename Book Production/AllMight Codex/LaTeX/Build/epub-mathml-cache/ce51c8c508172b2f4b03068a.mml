<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>p</mi><mi>y</mi></msub><mo>=</mo><mfrac><msup><mi>e</mi><mn>3.2</mn></msup><mrow><msup><mi>e</mi><mn>3.2</mn></msup><mo>+</mo><msup><mi>e</mi><mn>5.1</mn></msup><mo>+</mo><msup><mi>e</mi><mrow><mi>−</mi><mn>1.7</mn></mrow></msup></mrow></mfrac><mo>≈</mo><mn>0.129</mn><mo>,</mo><mspace width="2.0em"></mspace><mi>L</mi><mo>≈</mo><mi>−</mi><mrow><mi mathvariant="normal">log</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><mn>0.129</mn><mo stretchy="false" form="postfix">)</mo><mo>≈</mo><mn>2.05</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">p_y=\frac{e^{3.2}}{e^{3.2}+e^{5.1}+e^{-1.7}}\approx0.129, \qquad L\approx-\log(0.129)\approx2.05.</annotation></semantics></math>