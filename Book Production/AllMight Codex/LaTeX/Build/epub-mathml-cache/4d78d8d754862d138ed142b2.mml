<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>w</mi><mo>≤</mo><mo stretchy="false" form="prefix">⌊</mo><mtext mathvariant="normal">SIZE_MAX</mtext><mi>/</mi><mi>h</mi><mo stretchy="false" form="postfix">⌋</mo></mrow><annotation encoding="application/x-tex">w \le \lfloor\text{SIZE\_MAX}/h\rfloor</annotation></semantics></math>