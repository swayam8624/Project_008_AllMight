<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>p</mi><mi>ω</mi></msub><mo>=</mo><mfrac><mrow><msub><mi>p</mi><mi>A</mi></msub><mspace width="0.167em"></mspace><msup><mi>r</mi><mn>2</mn></msup></mrow><mrow><mo stretchy="false" form="prefix">|</mo><mrow><mi mathvariant="normal">cos</mi><mo>&#8289;</mo></mrow><mi>θ</mi><mo stretchy="false" form="prefix">|</mo></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">p_\omega=\frac{p_A\,r^2}{|\cos\theta|}.</annotation></semantics></math>