<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">roulette probability should estimate future contribution,</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">not blindly react to representation artifacts.</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{roulette probability should estimate future contribution,}\\\text{not blindly react to representation artifacts.}\end{gathered}}</annotation></semantics></math>