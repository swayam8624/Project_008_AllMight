<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow data-mjx-texclass="ORD">
    <mn mathvariant="monospace">0</mn>
    <mi mathvariant="monospace">x</mi>
    <mn mathvariant="monospace">987000</mn>
  </mrow>
  <mo>+</mo>
  <mrow data-mjx-texclass="ORD">
    <mn mathvariant="monospace">0</mn>
    <mi mathvariant="monospace">xABC</mi>
  </mrow>
  <mo>=</mo>
  <mrow data-mjx-texclass="ORD">
    <mn mathvariant="monospace">0</mn>
    <mi mathvariant="monospace">x</mi>
    <mn mathvariant="monospace">987</mn>
    <mi mathvariant="monospace">ABC</mi>
  </mrow>
</math>