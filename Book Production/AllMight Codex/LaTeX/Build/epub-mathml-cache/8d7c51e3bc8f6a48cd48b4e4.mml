<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">How do we represent millions of changing objects so that</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">identity remains safe while data remains compact,</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">cache-friendly, queryable and mutable?</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{How do we represent millions of changing objects so that}\\\text{identity remains safe while data remains compact,}\\\text{cache-friendly, queryable and mutable?}\end{gathered}}</annotation></semantics></math>