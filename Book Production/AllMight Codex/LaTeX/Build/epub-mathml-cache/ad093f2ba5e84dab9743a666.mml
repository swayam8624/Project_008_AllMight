<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">What if the dominant workload is not random component lookup,</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">but processing huge groups of identically shaped entities?</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{What if the dominant workload is not random component lookup,}\\\text{but processing huge groups of identically shaped entities?}\end{gathered}}</annotation></semantics></math>