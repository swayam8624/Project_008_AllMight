<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn><mo>−</mo><mn>2.25</mn><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>4</mn></mfrac></mstyle><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mn>0.4375</mn></mrow><annotation encoding="application/x-tex">k=1-2.25(1-\tfrac34)=0.4375</annotation></semantics></math>