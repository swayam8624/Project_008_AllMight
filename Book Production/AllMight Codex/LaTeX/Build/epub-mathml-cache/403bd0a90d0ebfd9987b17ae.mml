<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">action</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">Euler–Lagrange equations</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">Euler–Lagrange equations</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">conjugate momentum</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">conjugate momentum</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">Hamiltonian phase-space flow</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">Hamiltonian phase-space flow</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">symplectic discrete update</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{aligned}\text{action} &amp;\rightarrow \text{Euler--Lagrange equations}\\\text{Euler--Lagrange equations} &amp;\rightarrow \text{conjugate momentum}\\\text{conjugate momentum} &amp;\rightarrow \text{Hamiltonian phase-space flow}\\\text{Hamiltonian phase-space flow} &amp;\rightarrow \text{symplectic discrete update}\end{aligned}}</annotation></semantics></math>