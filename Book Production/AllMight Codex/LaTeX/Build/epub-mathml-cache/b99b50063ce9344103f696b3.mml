<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>x</mi><mo>=</mo><mfrac><mrow><msqrt><mrow><mn>1</mn><mo>+</mo><mn>8</mn><mi>u</mi></mrow></msqrt><mo>−</mo><mn>1</mn></mrow><mn>2</mn></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">x=\frac{\sqrt{1+8u}-1}{2}.</annotation></semantics></math>