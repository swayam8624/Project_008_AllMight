<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mn>10</mn><mo stretchy="false" form="prefix">(</mo><mn>3</mn><mo>⋅</mo><mn>5</mn><mo>⋅</mo><mn>5</mn><mo>+</mo><mn>1</mn><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mn>760</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">10(3\cdot5\cdot5+1)=760.</annotation></semantics></math>