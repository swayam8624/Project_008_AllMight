<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>x</mi><mi mathvariant="normal">min</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">min</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>+</mo><mi>h</mi><msub><mi>v</mi><mi>x</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>−</mo><mi>r</mi><mo>,</mo><mspace width="2.0em"></mspace><msub><mi>x</mi><mi mathvariant="normal">max</mi></msub><mo>=</mo><mrow><mi mathvariant="normal">max</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><msub><mi>x</mi><mn>0</mn></msub><mo>,</mo><msub><mi>x</mi><mn>0</mn></msub><mo>+</mo><mi>h</mi><msub><mi>v</mi><mi>x</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>+</mo><mi>r</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">x_{\min}=\min(x_0,x_0+hv_x)-r,\qquad x_{\max}=\max(x_0,x_0+hv_x)+r,</annotation></semantics></math>