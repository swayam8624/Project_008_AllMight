<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">scene</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">resource upload</mtext><mo>→</mo><mtext mathvariant="normal">command recording</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">command recording</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">submission</mtext><mo>→</mo><mtext mathvariant="normal">vertex stage</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">vertex stage</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">clipping</mtext><mo>→</mo><mtext mathvariant="normal">rasterization</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">rasterization</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">fragment stage</mtext><mo>→</mo><mtext mathvariant="normal">depth/stencil</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">depth/stencil</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">attachment</mtext><mo>→</mo><mtext mathvariant="normal">presentation</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{scene} &amp;\rightarrow \text{resource upload} \rightarrow \text{command recording} \\\text{command recording} &amp;\rightarrow \text{submission} \rightarrow \text{vertex stage} \\\text{vertex stage} &amp;\rightarrow \tex