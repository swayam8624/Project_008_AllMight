<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>d</mi><msub><mi>f</mi><mi>q</mi></msub><mo stretchy="false" form="prefix">(</mo><mi>δ</mi><mi>q</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msubsup><mi>g</mi><mi>q</mi><mi>T</mi></msubsup><mi>G</mi><mi>δ</mi><mi>q</mi></mrow><annotation encoding="application/x-tex">df_q(\delta q)=g_q^TG\delta q</annotation></semantics></math>