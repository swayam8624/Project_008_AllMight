<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">vertex/index memory</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">primitive assembly</mtext><mo>→</mo><mtext mathvariant="normal">vertex processing</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">vertex processing</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">clip coordinates</mtext><mo>→</mo><mtext mathvariant="normal">clipping</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">clipping</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">perspective divide</mtext><mo>→</mo><mtext mathvariant="normal">NDC</mtext><mo>→</mo><mtext mathvariant="normal">viewport</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">viewport</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">triangle setup</mtext><mo>→</mo><mtext mathvariant="normal">coverage</mtext><mo>→</mo><mtext mathvariant="normal">interpolation</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">interpolation</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">fragment invocation</mtext><mo>→</mo><mtext mathvariant="normal">depth test</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{vertex/index memory} &amp;\rightarrow \text{primitive assembly} \rightarrow \text{vertex processing}\\\text{vertex processing} &amp;\rightarrow \text{clip coordinates} \rightarrow \text{clipping}\\\text{clipping} &amp;\rightarrow \text{perspective divide} \rightarrow \text{NDC} \rightarrow \text{viewport}\\\text{viewport} &amp;\rightarrow \text{triangle setup} \rightarrow \text{coverage} \rightarrow \text{interpolation}\\\text{interpolation} &amp;\rightarrow \text{fragment invocation} \rightarrow \text{depth test}.\end{aligned}</annotation></semantics></math>