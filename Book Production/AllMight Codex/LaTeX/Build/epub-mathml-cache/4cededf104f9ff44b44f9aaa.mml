<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>k</mi><mo>=</mo><mn>1</mn><mo>−</mo><msup><mn>1.5</mn><mn>2</mn></msup><mrow><mo stretchy="true" form="prefix">(</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo stretchy="true" form="postfix">)</mo></mrow><mo>=</mo><mi>−</mi><mn>0.125</mn><mi>.</mi></mrow><annotation encoding="application/x-tex">k=1-1.5^2\left(1-\frac12\right)=-0.125.</annotation></semantics></math>