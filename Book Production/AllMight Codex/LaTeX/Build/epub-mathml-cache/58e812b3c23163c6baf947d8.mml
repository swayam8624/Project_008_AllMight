<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>∂</mi><mi>t</mi></msub><mi>u</mi><mo>=</mo><mi>κ</mi><mo stretchy="false" form="prefix">(</mo><msub><mi>∂</mi><mrow><mi>x</mi><mi>x</mi></mrow></msub><mi>u</mi><mo>+</mo><msub><mi>∂</mi><mrow><mi>y</mi><mi>y</mi></mrow></msub><mi>u</mi><mo stretchy="false" form="postfix">)</mo></mrow><annotation encoding="application/x-tex">\partial_tu=\kappa(\partial_{xx}u+\partial_{yy}u)</annotation></semantics></math>