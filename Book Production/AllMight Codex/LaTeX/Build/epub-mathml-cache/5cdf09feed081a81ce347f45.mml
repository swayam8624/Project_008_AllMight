<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>p</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>=</mo><msub><mi>p</mi><mi>A</mi></msub><mspace width="0.167em"></mspace><mn>6</mn><mspace width="0.167em"></mspace><msup><mi mathvariant="normal">m</mi><mn>2</mn></msup><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">p_{s,t}=p_A\,6\,\mathrm m^2=1</annotation></semantics></math>