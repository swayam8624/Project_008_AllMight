<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mrow><mi mathvariant="normal">Var</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><msub><mover><mi>c</mi><mo accent="true">̂</mo></mover><mi>N</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>=</mo><mfrac><mrow><mi>c</mi><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><mi>c</mi><mo stretchy="false" form="postfix">)</mo></mrow><mi>N</mi></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">\operatorname{Var}(\widehat c_N)
=\frac{c(1-c)}{N}.</annotation></semantics></math>