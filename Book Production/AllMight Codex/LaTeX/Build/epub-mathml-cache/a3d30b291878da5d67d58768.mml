<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">make ownership explicit</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mi>+</mi><mspace width="0.278em"></mspace><mtext mathvariant="normal">make access patterns measurable</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mi>+</mi><mspace width="0.278em"></mspace><mtext mathvariant="normal">make async lifetime nested</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mi>+</mi><mspace width="0.278em"></mspace><mtext mathvariant="normal">make performance claims reproducible</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{make ownership explicit}\\+\;\text{make access patterns measurable}\\+\;\text{make async lifetime nested}\\+\;\text{make performance claims reproducible}\end{gathered}}</annotation></semantics></math>