<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>M</mi><mrow><mi>i</mi><mi>i</mi></mrow></msub><mo>=</mo><msub><mo>∑</mo><mrow><mi>T</mi><mo>∋</mo><mi>i</mi></mrow></msub><msub><mi>A</mi><mi>T</mi></msub><mi>/</mi><mn>3</mn></mrow><annotation encoding="application/x-tex">M_{ii}=\sum_{T\ni i}A_T/3</annotation></semantics></math>