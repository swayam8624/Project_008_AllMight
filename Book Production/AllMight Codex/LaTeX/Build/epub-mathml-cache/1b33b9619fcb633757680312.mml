<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>G</mi><mo>=</mo><msup><mi>A</mi><mi>T</mi></msup><mi>A</mi><mo>=</mo><mrow><mo stretchy="true" form="prefix">(</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><mn>4</mn></mtd><mtd columnalign="center" style="text-align: center"><mn>2</mn></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mn>2</mn></mtd><mtd columnalign="center" style="text-align: center"><mn>10</mn></mtd></mtr></mtable><mo stretchy="true" form="postfix">)</mo></mrow><mo>,</mo><mspace width="2.0em"></mspace><msup><mrow><mo stretchy="true" form="prefix">‖</mo><mi>δ</mi><mi>p</mi><mo stretchy="true" form="postfix">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mi>δ</mi><msup><mi>q</mi><mi>T</mi></msup><mi>G</mi><mspace width="0.167em"></mspace><mi>δ</mi><mi>q</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">G=A^TA=\begin{pmatrix}4&amp;2\\2&amp;10\end{pmatrix},
\qquad
\lVert\delta p\rVert^2=\delta q^TG\,\delta q.</annotation></semantics></math>