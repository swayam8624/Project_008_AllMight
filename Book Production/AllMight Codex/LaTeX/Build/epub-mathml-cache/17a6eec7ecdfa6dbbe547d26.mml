<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>w</mi><mi>i</mi></msub><mo>=</mo><msub><mi>ψ</mi><mi>δ</mi></msub><mo stretchy="false" form="prefix">(</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false" form="postfix">)</mo><mi>/</mi><msub><mi>r</mi><mi>i</mi></msub></mrow><annotation encoding="application/x-tex">w_i=\psi_\delta(r_i)/r_i</annotation></semantics></math>