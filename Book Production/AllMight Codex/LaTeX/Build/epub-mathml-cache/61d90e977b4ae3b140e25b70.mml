<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>b</mi><mi>n</mi></msub><mo>−</mo><msub><mi>a</mi><mi>n</mi></msub><mo>=</mo><mfrac><mrow><msub><mi>b</mi><mn>0</mn></msub><mo>−</mo><msub><mi>a</mi><mn>0</mn></msub></mrow><msup><mn>2</mn><mi>n</mi></msup></mfrac><mo>=</mo><mfrac><mn>1</mn><msup><mn>2</mn><mi>n</mi></msup></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">b_n-a_n=\frac{b_0-a_0}{2^n}=\frac1{2^n}.</annotation></semantics></math>