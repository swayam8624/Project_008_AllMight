<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="bold-italic">𝒏</mi><mo>=</mo><msub><mi>∇</mi><mi mathvariant="bold-italic">𝒑</mi></msub><mo stretchy="false" form="prefix">|</mo><mi mathvariant="bold-italic">𝒑</mi><mo stretchy="false" form="prefix">|</mo><mo>=</mo><mfrac><mi mathvariant="bold-italic">𝒑</mi><mrow><mo stretchy="false" form="postfix">∥</mo><mi mathvariant="bold-italic">𝒑</mi><mo stretchy="false" form="postfix">∥</mo></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">\mathbf n=\nabla_{\mathbf p}|\mathbf p| =\frac{\mathbf p}{\|\mathbf p\|}.</annotation></semantics></math>