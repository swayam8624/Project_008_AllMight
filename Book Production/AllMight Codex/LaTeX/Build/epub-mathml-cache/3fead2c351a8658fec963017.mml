<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msubsup><mi>u</mi><mi>i</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msubsup><mo>=</mo><mo stretchy="false" form="prefix">(</mo><mn>1</mn><mo>−</mo><mn>2</mn><mi>r</mi><mo stretchy="false" form="postfix">)</mo><msubsup><mi>u</mi><mi>i</mi><mi>n</mi></msubsup><mo>+</mo><mi>r</mi><msubsup><mi>u</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>+</mo><mi>r</mi><msubsup><mi>u</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mo>,</mo><mspace width="2.0em"></mspace><mi>r</mi><mo>=</mo><mfrac><mrow><mi>α</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">Δ</mi><mi>t</mi></mrow><mrow><mo stretchy="false" form="prefix">(</mo><mi mathvariant="normal">Δ</mi><mi>x</mi><msup><mo stretchy="false" form="postfix">)</mo><mn>2</mn></msup></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">u_i^{n+1}=(1-2r)u_i^n+r u_{i-1}^n+r u_{i+1}^n,\qquad
r=\frac{\alpha\,\Delta t}{(\Delta x)^2}.</annotation></semantics></math>