<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="normal">Δ</mi><mi>t</mi><mo>≤</mo><mfrac><msup><mi>h</mi><mn>2</mn></msup><mrow><mn>4</mn><mi>κ</mi></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">\Delta t\le\frac{h^2}{4\kappa}.</annotation></semantics></math>