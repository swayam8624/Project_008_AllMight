<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mrow><mn>4</mn><msub><mi>N</mi><mi>L</mi></msub><msub><mi>N</mi><mi>V</mi></msub><mo>=</mo><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">geometry/Jacobian normalization required to express</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">microscopic mirror area as a macroscopic BRDF</mtext><mi>.</mi></mtd></mtr></mtable></mrow></menclose><annotation encoding="application/x-tex">\boxed{4N_LN_V=\begin{gathered}\text{geometry/Jacobian normalization required to express}\\\text{microscopic mirror area as a macroscopic BRDF}.\end{gathered}}</annotation></semantics></math>