<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>X</mi><mo>=</mo><mi>−</mi><mfrac><mrow><mi>∇</mi><mi>u</mi></mrow><mrow><mo stretchy="true" form="prefix">‖</mo><mi>∇</mi><mi>u</mi><mo stretchy="true" form="postfix">‖</mo></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">X=-\frac{\nabla u}{\lVert\nabla u\rVert}.</annotation></semantics></math>