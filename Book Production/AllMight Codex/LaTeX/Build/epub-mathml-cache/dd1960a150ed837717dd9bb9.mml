<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mover><mi>Q</mi><mo accent="true">̂</mo></mover><mo>−</mo><mi>Q</mi><mo>=</mo><mrow></mrow></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mtext mathvariant="normal">modeling contribution</mtext><mo>+</mo><mtext mathvariant="normal">discretization contribution</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mi>+</mi><mtext mathvariant="normal">solver contribution</mtext><mo>+</mo><mtext mathvariant="normal">arithmetic contribution</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{aligned}\hat Q-Q ={}&amp;\text{modeling contribution} + \text{discretization contribution}\\&amp;+\text{solver contribution} + \text{arithmetic contribution}\end{aligned}}</annotation></semantics></math>