<math xmlns="http://www.w3.org/1998/Math/MathML">
  <msup>
    <mi>A</mi>
    <mrow data-mjx-texclass="ORD">
      <mi mathvariant="sans-serif">T</mi>
    </mrow>
  </msup>
  <mo stretchy="false">(</mo>
  <mi>A</mi>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="bold">x</mi>
      </mrow>
      <mo>^</mo>
    </mover>
  </mrow>
  <mo>&#x2212;</mo>
  <mrow data-mjx-texclass="ORD">
    <mi mathvariant="bold">b</mi>
  </mrow>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mn>0</mn>
</math>