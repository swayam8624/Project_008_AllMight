<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">projection</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">tile counts</mtext><mo>→</mo><mtext mathvariant="normal">scan</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">scan</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">key generation</mtext><mo>→</mo><mtext mathvariant="normal">radix histogram</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">radix histogram</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">prefix</mtext><mo>→</mo><mtext mathvariant="normal">scatter</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">scatter</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">tile ranges</mtext><mo>→</mo><mtext mathvariant="normal">composite</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{projection} &amp;\rightarrow \text{tile counts} \rightarrow \text{scan}\\\text{scan} &amp;\rightarrow \text{key generation} \rightarrow \text{radix histogram}\\\text{radix histogram} &amp;\rightarrow \text{prefix} \rightarrow \text{scatter}\\\text{scatter} &amp;\rightarrow \text{tile ranges} \rightarrow \text{composite}.\end{aligned}</annotation></semantics></math>