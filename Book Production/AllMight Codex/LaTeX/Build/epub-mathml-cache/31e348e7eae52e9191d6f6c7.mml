<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">PLY</mtext><mo>→</mo><mtext mathvariant="normal">Gaussian field</mtext><mo>→</mo><mtext mathvariant="normal">semantic entity correspondence</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">physical support embedding</mtext><mo>→</mo><mtext mathvariant="normal">physical deformation</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mi>F</mi><mi mathvariant="normal">Σ</mi><msup><mi>F</mi><mi>T</mi></msup><mo>→</mo><mtext mathvariant="normal">updated Gaussian rendering</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">image verification</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{PLY}\rightarrow\text{Gaussian field}\rightarrow\text{semantic entity correspondence}\\\rightarrow\text{physical support embedding}\rightarrow\text{physical deformation}\\\rightarrow F\Sigma F^T\rightarrow\text{updated Gaussian rendering}\\\rightarrow\text{image verification}\end{gathered}}</annotation></semantics></math>