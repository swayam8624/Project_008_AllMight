<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>δ</mi><mo>=</mo><msup><mn>10</mn><mrow><mi>−</mi><mn>1</mn></mrow></msup><mo>,</mo><msup><mn>10</mn><mrow><mi>−</mi><mn>2</mn></mrow></msup><mo>,</mo><mi>…</mi><mo>,</mo><msup><mn>10</mn><mrow><mi>−</mi><mn>8</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\delta=10^{-1},10^{-2},\ldots,10^{-8}</annotation></semantics></math>