      </mtd>
    </mtr>
    <mtr>
      <mtd>
        <mtext>&#xA0;</mtext>
        <mrow data-mjx-texclass="OP">
          <mi>orient</mi>
          <mn>2</mn>
          <mi mathvariant="normal">D</mi>
        </mrow>
        <mo>=</mo>
        <mn>0</mn>
      </mtd>
      <mtd>
        <mi></mi>
        <mo>:</mo>
        <mtext>collinear</mtext>
