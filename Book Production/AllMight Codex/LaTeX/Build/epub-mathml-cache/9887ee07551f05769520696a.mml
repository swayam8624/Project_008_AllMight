<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>v</mi><mi>n</mi></msub><mo>=</mo><mi mathvariant="bold-italic">𝒏</mi><mo>⋅</mo><mrow><mo stretchy="true" form="prefix">[</mo><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒗</mi><mi>B</mi></msub><mo>+</mo><msub><mi>ω</mi><mi>B</mi></msub><mo>×</mo><msub><mi mathvariant="bold-italic">𝒓</mi><mi>B</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>−</mo><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒗</mi><mi>A</mi></msub><mo>+</mo><msub><mi>ω</mi><mi>A</mi></msub><mo>×</mo><msub><mi mathvariant="bold-italic">𝒓</mi><mi>A</mi></msub><mo stretchy="false" form="postfix">)</mo><mo stretchy="true" form="postfix">]</mo></mrow><mi>.</mi></mrow><annotation encoding="application/x-tex">v_n=\mathbf n\cdot\left[
(\mathbf v_B+\omega_B\times\mathbf r_B)-
(\mathbf v_A+\omega_A\times\mathbf r_A)\right].</annotation></semantics></math>