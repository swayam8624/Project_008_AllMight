<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mtable><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">geometry generates samples</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">stencil classifies existing sample state</mtext></mtd></mtr><mtr><mtd columnalign="right" style="text-align: right; padding-right: 0"><mtext mathvariant="normal">stencil classifies existing sample state</mtext></mtd><mtd columnalign="left" style="text-align: left; padding-left: 0"><mo>→</mo><mtext mathvariant="normal">pipeline conditionally permits/modifies fragments</mtext><mi>.</mi></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned}\text{geometry generates samples} &amp;\rightarrow \text{stencil classifies existing sample state}\\\text{stencil classifies existing sample state} &amp;\rightarrow \text{pipeline conditionally permits/modifies fragments}.\end{aligned}</annotation></semantics></math>