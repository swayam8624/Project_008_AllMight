<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mi>y</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mi>y</mi><mi>k</mi></msub><mo>−</mo><mn>0.8</mn><mo stretchy="false" form="prefix">(</mo><msub><mi>y</mi><mi>k</mi></msub><mo>+</mo><mn>0.5</mn><mo stretchy="false" form="postfix">)</mo></mrow><annotation encoding="application/x-tex">y_{k+1}=y_k-0.8(y_k+0.5)</annotation></semantics></math>