<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mi>L</mi>
          <mo stretchy="false">(</mo>
          <mi mathvariant="bold-italic">&#x3B8;</mi>
          <mo stretchy="false">)</mo>
          <mo>=</mo>
          <mfrac>
            <mn>1</mn>
            <mn>2</mn>
          </mfrac>
          <munderover>
            <mo data-mjx-texclass="OP">&#x2211;</mo>
            <mrow data-mjx-texclass="ORD">
              <mi>i</mi>
              <mo>=</mo>
              <mn>1</mn>
            </mrow>
            <mrow data-mjx-texclass="ORD">
              <mi>N</mi>
            </mrow>
          </munderover>
          <msup>
            <mrow data-mjx-texclass="INNER">
              <mo data-mjx-texclass="OPEN" symmetric="true">&#x2016;</mo>
              <msub>
                <mrow data-mjx-texclass="ORD">
                  <mi mathvariant="bold">x</mi>
                </mrow>
                <mrow data-mjx-texclass="ORD">
                  <mrow data-mjx-texclass="ORD">
                    <mi data-mjx-auto-op="false">simulated</mi>
                  </mrow>
                </mrow>
              </msub>
              <mo stretchy="false">(</mo>
              <msub>
                <mi>t</mi>
                <mi>i</mi>
              </msub>
              <mo>;</mo>
              <mi mathvariant="bold-italic">&#x3B8;</mi>
              <mo stretchy="false">)</mo>
              <mo>&#x2212;</mo>
              <msub>
                <mrow data-mjx-texclass="ORD">
                  <mi mathvariant="bold">x</mi>
                </mrow>
                <mrow data-mjx-texclass="ORD">
                  <mrow data-mjx-texclass="ORD">
                    <mi data-mjx-auto-op="false">observed</mi>
                  </mrow>
                </mrow>
              </msub>
              <mo stretchy="false">(</mo>
              <msub>
                <mi>t</mi>
                <mi>i</mi>
              </msub>
              <mo stretchy="false">)</mo>
              <mo data-mjx-texclass="CLOSE" symmetric="true">&#x2016;</mo>
            </mrow>
            <mn>2</mn>
          </msup>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
</math>