<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <munderover>
    <mo data-mjx-texclass="OP">&#x220F;</mo>
    <mrow data-mjx-texclass="ORD">
      <mi>i</mi>
      <mo>=</mo>
      <mn>1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD">
      <mi>n</mi>
    </mrow>
  </munderover>
  <mfrac>
    <mn>1</mn>
    <msqrt>
      <mn>2</mn>
      <mi>&#x3C0;</mi>
    </msqrt>
  </mfrac>
  <mo>=</mo>
  <mfrac>
    <mn>1</mn>
    <mrow>
      <mo stretchy="false">(</mo>
      <mn>2</mn>
      <mi>&#x3C0;</mi>
      <msup>
        <mo stretchy="false">)</mo>
        <mrow data-mjx-texclass="ORD">
          <mi>n</mi>
          <mrow data-mjx-texclass="ORD">
            <mo>/</mo>
          </mrow>
          <mn>2</mn>
        </mrow>
      </msup>
    </mrow>
  </mfrac>
  <mo>.</mo>
</math>