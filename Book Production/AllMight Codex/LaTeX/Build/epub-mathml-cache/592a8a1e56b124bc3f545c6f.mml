<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>L</mi><mo>=</mo><munderover><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover><msub><mi>L</mi><mi>t</mi></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">L=\sum_{t=1}^{T} L_t.</annotation></semantics></math>