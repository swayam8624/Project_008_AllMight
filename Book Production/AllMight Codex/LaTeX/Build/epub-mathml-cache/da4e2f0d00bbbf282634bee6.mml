<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>r</mi><mo stretchy="false" form="prefix">(</mo><mi>θ</mi><mo>+</mo><mi mathvariant="normal">Δ</mi><mo stretchy="false" form="postfix">)</mo><mo>≈</mo><mi>r</mi><mo>+</mo><mi>J</mi><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">r(\theta+\Delta)\approx r+J\Delta</annotation></semantics></math>