<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><msub><mover><mi>c</mi><mo accent="true">̂</mo></mover><mi>N</mi></msub><mo>=</mo><mfrac><mn>1</mn><mi>N</mi></mfrac><munderover><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover><msub><mi>H</mi><mi>i</mi></msub><mi>.</mi></mrow><annotation encoding="application/x-tex">\widehat c_N=\frac1N\sum_{i=1}^NH_i.</annotation></semantics></math>