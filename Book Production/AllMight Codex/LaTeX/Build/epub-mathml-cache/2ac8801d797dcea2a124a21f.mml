<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi mathvariant="bold-italic">𝒒</mi><mo stretchy="false" form="prefix">(</mo><mi>t</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msub><mi mathvariant="bold-italic">𝒒</mi><mn>0</mn></msub><mo>+</mo><mi>t</mi><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒒</mi><mn>1</mn></msub><mo>−</mo><msub><mi mathvariant="bold-italic">𝒒</mi><mn>0</mn></msub><mo stretchy="false" form="postfix">)</mo><mo>,</mo><mspace width="2.0em"></mspace><mi>t</mi><mo>=</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>−</mo><msub><mi>d</mi><mn>1</mn></msub></mrow></mfrac><mi>.</mi></mrow><annotation encoding="application/x-tex">\mathbf q(t)=\mathbf q_0+t(\mathbf q_1-\mathbf q_0), \qquad t=\frac{d_0}{d_0-d_1}.</annotation></semantics></math>