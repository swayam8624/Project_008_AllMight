<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mrow><mi mathvariant="normal">m</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">x</mi></mrow><mi>/</mi><mi>y</mi></mrow><annotation encoding="application/x-tex">x &gt; \mathrm{max}/y</annotation></semantics></math>