<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>λ</mi><msup><mrow><mi>t</mi><mo>,</mo><mi>n</mi><mi>e</mi><mi>w</mi></mrow><mrow><mi>s</mi><mi>e</mi><mi>e</mi><mi>d</mi></mrow></msup><mo>=</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mrow><mi>n</mi><mi>e</mi><mi>w</mi></mrow></msub></mrow><mrow><mi mathvariant="normal">Δ</mi><msub><mi>t</mi><mrow><mi>o</mi><mi>l</mi><mi>d</mi></mrow></msub></mrow></mfrac><mrow><mo stretchy="true" form="prefix">(</mo><mi>λ</mi><mrow><mi>t</mi><mo>,</mo><mi>o</mi><mi>l</mi><mi>d</mi></mrow><mo>,</mo><msub><mi mathvariant="bold-italic">𝒕</mi><mrow><mi>o</mi><mi>l</mi><mi>d</mi></mrow></msub><mo>⋅</mo><msub><mi mathvariant="bold-italic">𝒕</mi><mrow><mi>n</mi><mi>e</mi><mi>w</mi></mrow></msub><mo stretchy="true" form="postfix">)</mo></mrow><mi>.</mi></mrow><annotation encoding="application/x-tex">\lambda{t,new}^{seed} = \frac{\Delta t_{new}}{\Delta t_{old}} \left(\lambda{t,old},\mathbf t_{old}\cdot\mathbf t_{new}\right).</annotation></semantics></math>