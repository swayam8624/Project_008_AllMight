<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">generational identity</mtext><mo>→</mo><mtext mathvariant="normal">slot reuse</mtext><mo>→</mo><mtext mathvariant="normal">typed pools</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">sparse indirection</mtext><mo>→</mo><mtext mathvariant="normal">dense storage</mtext><mo>→</mo><mtext mathvariant="normal">constant-time membership</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">smallest-pool joins</mtext><mo>→</mo><mtext mathvariant="normal">invalidation rules</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mo>→</mo><mtext mathvariant="normal">deferred structural mutation</mtext><mi>.</mi></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{generational identity}\rightarrow\text{slot reuse}\rightarrow\text{typed pools}\\\rightarrow\text{sparse indirection}\rightarrow\text{dense storage}\rightarrow\text{constant-time membership}\\\rightarrow\text{smallest-pool joins}\rightarrow\text{invalidation rules}\\\rightarrow\text{deferred structural mutation}.\end{gathered}}</annotation></semantics></math>