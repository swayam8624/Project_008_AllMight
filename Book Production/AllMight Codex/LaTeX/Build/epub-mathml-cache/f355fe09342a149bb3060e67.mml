<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>w</mi><mo stretchy="false" form="prefix">(</mo><mi>y</mi><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msub><mi>x</mi><mi>R</mi></msub><mo>−</mo><msub><mi>x</mi><mi>L</mi></msub><mo>=</mo><mstyle displaystyle="false"><mfrac><mn>15</mn><mn>8</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>3</mn><mn>2</mn></mfrac></mstyle><mi>y</mi><mi>.</mi></mrow><annotation encoding="application/x-tex">w(y)=x_R-x_L=\tfrac{15}{8}-\tfrac32y.</annotation></semantics></math>