<math display="inline" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>λ</mi><mrow><mi>n</mi><mi>e</mi><mi>x</mi><mi>t</mi></mrow><mo>=</mo><mrow><mi mathvariant="normal">max</mi><mo>&#8289;</mo></mrow><mrow><mo stretchy="true" form="prefix">(</mo><mn>0</mn><mo>,</mo><mi>λ</mi><mrow><mi>p</mi><mi>r</mi><mi>e</mi><mi>v</mi><mi>i</mi><mi>o</mi><mi>u</mi><mi>s</mi></mrow><mo>+</mo><mfrac><mrow><mi>b</mi><mo>−</mo><mo stretchy="false" form="prefix">(</mo><msub><mi mathvariant="bold-italic">𝒗</mi><mi>B</mi></msub><mo>−</mo><msub><mi mathvariant="bold-italic">𝒗</mi><mi>A</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>⋅</mo><mi mathvariant="bold-italic">𝒏</mi></mrow><mrow><msub><mi>m</mi><mi>A</mi></msub><mrow><mi>−</mi><mn>1</mn></mrow><mo>+</mo><msub><mi>m</mi><mi>B</mi></msub><mrow><mi>−</mi><mn>1</mn></mrow></mrow></mfrac><mo stretchy="true" form="postfix">)</mo></mrow><mi>.</mi></mrow><annotation encoding="application/x-tex">\lambda{next}=\max\left(0,\lambda{previous} +\frac{b-(\mathbf v_B-\mathbf v_A)\cdot\mathbf n} {m_A{-1}+m_B{-1}}\right).</annotation></semantics></math>