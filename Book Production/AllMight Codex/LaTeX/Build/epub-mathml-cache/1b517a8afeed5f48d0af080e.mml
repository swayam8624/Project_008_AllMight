<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><mrow><mi>τ</mi><mo>=</mo><mn>4</mn><mo>+</mo><mn>2</mn><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mn>2</mn></msup><mo>,</mo><mspace width="2.0em"></mspace><mrow><mi mathvariant="normal">det</mi><mo>&#8289;</mo></mrow><mo stretchy="false" form="prefix">(</mo><msubsup><mi>A</mi><mi>δ</mi><mi>T</mi></msubsup><msub><mi>A</mi><mi>δ</mi></msub><mo stretchy="false" form="postfix">)</mo><mo>=</mo><msup><mi>δ</mi><mn>2</mn></msup><mi>.</mi></mrow><annotation encoding="application/x-tex">\tau=4+2\delta+\delta^2,\qquad
\det(A_\delta^TA_\delta)=\delta^2.</annotation></semantics></math>