<math display="block" xmlns="http://www.w3.org/1998/Math/MathML"><semantics><menclose notation="box"><mtable><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">Any transient value capable of changing future evolution</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">belongs to deterministic state at the instant it is</mtext></mtd></mtr><mtr><mtd columnalign="center" style="text-align: center"><mtext mathvariant="normal">captured.</mtext></mtd></mtr></mtable></menclose><annotation encoding="application/x-tex">\boxed{\begin{gathered}\text{Any transient value capable of changing future evolution}\\\text{belongs to deterministic state at the instant it is}\\\text{captured.}\end{gathered}}</annotation></semantics></math>