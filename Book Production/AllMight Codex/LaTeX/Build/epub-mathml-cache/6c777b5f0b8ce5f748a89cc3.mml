<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi mathvariant="normal">&#x394;</mi>
  <mo>=</mo>
  <msub>
    <mi>f</mi>
    <mi>x</mi>
  </msub>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">[</mo>
    <mfrac>
      <mrow>
        <mi>X</mi>
        <mo>+</mo>
        <mi>B</mi>
        <mrow data-mjx-texclass="ORD">
          <mo>/</mo>
        </mrow>
        <mn>2</mn>
      </mrow>
      <mi>Z</mi>
    </mfrac>
    <mo>&#x2212;</mo>
    <mfrac>
      <mrow>
        <mi>X</mi>
        <mo>&#x2212;</mo>
        <mi>B</mi>
        <mrow data-mjx-texclass="ORD">
          <mo>/</mo>
        </mrow>
        <mn>2</mn>
      </mrow>
      <mi>Z</mi>
    </mfrac>
    <mo data-mjx-texclass="CLOSE">]</mo>
  </mrow>
  <mo>.</mo>
</math>