<math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics>
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mi>Var</mi>
          <mo stretchy="false">(</mo>
          <mrow data-mjx-texclass="ORD">
            <mover>
              <mi>Y</mi>
              <mo stretchy="false">¯</mo>
            </mover>
          </mrow>
          <mo stretchy="false">)</mo>
          <mo>=</mo>
          <mfrac>
            <mn>1</mn>
            <msup>
              <mi>N</mi>
              <mn>2</mn>
            </msup>
          </mfrac>
          <mrow data-mjx-texclass="INNER">
            <mo data-mjx-texclass="OPEN">[</mo>
            <munder>
              <mo data-mjx-texclass="OP">∑</mo>
              <mi>i</mi>
            </munder>
            <mi>Var</mi>
            <mo stretchy="false">(</mo>
            <msub>
              <mi>Y</mi>
              <mi>i</mi>
            </msub>
            <mo stretchy="false">)</mo>
            <mo>+</mo>
            <mn>2</mn>
            <munder>
              <mo data-mjx-texclass="OP">∑</mo>
              <mrow data-mjx-texclass="ORD">
                <mi>i</mi>
                <mo>&lt;</mo>
                <mi>j</mi>
              </mrow>
            </munder>
            <mi>Cov</mi>
            <mo stretchy="false">(</mo>
            <msub>
              <mi>Y</mi>
              <mi>i</mi>
            </msub>
            <mo>,</mo>
            <msub>
              <mi>Y</mi>
              <mi>j</mi>
            </msub>
            <mo stretchy="false">)</mo>
            <mo data-mjx-texclass="CLOSE">]</mo>
          </mrow>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
<annotation encoding="application/x-tex">
 \boxed{ \operatorname{Var}(\bar Y) = \frac1{N^2} \left[ \sum_i\operatorname{Var}(Y_i) + 2\sum_{i\&lt;j}\operatorname{Cov}(Y_i,Y_j) \right] }.
</annotation></semantics></math>