  </mrow>
  <mo stretchy="false">)</mo>
  <mo>=</mo>
  <mfrac>
    <mrow>
      <mo stretchy="false">|</mo>
      <mo data-mjx-texclass="OP" movablelimits="true">det</mo>
      <msup>
        <mi>A</mi>
        <mrow data-mjx-texclass="ORD">
          <mo>&#x2212;</mo>
          <mn>1</mn>
        </mrow>
      </msup>
      <mo stretchy="false">|</mo>
    </mrow>
    <mrow>
      <mo stretchy="false">(</mo>
      <mn>2</mn>
      <mi>&#x3C0;</mi>
      <msup>
        <mo stretchy="false">)</mo>
        <mrow data-mjx-texclass="ORD">
          <mi>n</mi>
          <mrow data-mjx-texclass="ORD">
            <mo>/</mo>
          </mrow>
          <mn>2</mn>
        </mrow>
      </msup>
    </mrow>
  </mfrac>
  <mi>exp</mi>
  <mo data-mjx-texclass="NONE">&#x2061;</mo>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">[</mo>
