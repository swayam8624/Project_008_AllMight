<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mrow data-mjx-texclass="ORD">
    <mi mathvariant="double-struck">E</mi>
  </mrow>
  <mo stretchy="false">[</mo>
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>I</mi>
      <mo>^</mo>
    </mover>
  </mrow>
  <mo stretchy="false">]</mo>
  <mo>=</mo>
  <mfrac>
    <mrow>
      <mn>3</mn>
      <mo stretchy="false">(</mo>
      <mn>1</mn>
      <mrow data-mjx-texclass="ORD">
        <mo>/</mo>
      </mrow>
      <mn>6</mn>
      <mo stretchy="false">)</mo>
      <mo>+</mo>
      <mn>2</mn>
      <mo stretchy="false">(</mo>
      <mn>1</mn>
      <mrow data-mjx-texclass="ORD">
        <mo>/</mo>
      </mrow>
      <mn>2</mn>
      <mo stretchy="false">)</mo>
    </mrow>
    <mn>5</mn>
  </mfrac>
  <mo>=</mo>
  <mn>0.3</mn>
  <mo>,</mo>
</math>