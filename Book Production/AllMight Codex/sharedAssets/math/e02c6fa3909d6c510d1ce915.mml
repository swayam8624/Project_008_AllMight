<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <msub>
    <mrow data-mjx-texclass="ORD">
      <mover>
        <mi>se</mi>
        <mo>^</mo>
      </mover>
    </mrow>
    <mrow data-mjx-texclass="ORD">
      <mrow data-mjx-texclass="ORD">
        <mi data-mjx-auto-op="false">boot</mi>
      </mrow>
    </mrow>
  </msub>
  <mo>=</mo>
  <msqrt>
    <mfrac>
      <mn>1</mn>
      <mrow>
        <mi>B</mi>
        <mo>&#x2212;</mo>
        <mn>1</mn>
      </mrow>
    </mfrac>
    <munderover>
      <mo data-mjx-texclass="OP">&#x2211;</mo>
      <mrow data-mjx-texclass="ORD">
        <mi>b</mi>
        <mo>=</mo>
        <mn>1</mn>
      </mrow>
      <mrow data-mjx-texclass="ORD">
        <mi>B</mi>
      </mrow>
    </munderover>
    <mo stretchy="false">(</mo>
    <msubsup>
      <mrow data-mjx-texclass="ORD">
        <mover>
          <mi>&#x3B8;</mi>
          <mo stretchy="false">^</mo>
        </mover>
      </mrow>
      <mi>b</mi>
      <mo>&#x2217;</mo>
    </msubsup>
    <mo>&#x2212;</mo>
    <msup>
      <mrow data-mjx-texclass="ORD">
        <mover>
          <mi>&#x3B8;</mi>
          <mo stretchy="false">&#xAF;</mo>
        </mover>
      </mrow>
      <mo>&#x2217;</mo>
    </msup>
    <msup>
      <mo stretchy="false">)</mo>
      <mn>2</mn>
    </msup>
  </msqrt>
  <mo>.</mo>
</math>