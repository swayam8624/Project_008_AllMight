<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mrow data-mjx-texclass="ORD">
        <mi mathvariant="bold">n</mi>
      </mrow>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mo>=</mo>
  <mo stretchy="false">(</mo>
  <mo>&#x2212;</mo>
  <mi>p</mi>
  <mo>,</mo>
  <mo>&#x2212;</mo>
  <mi>q</mi>
  <mo>,</mo>
  <mn>1</mn>
  <mo stretchy="false">)</mo>
  <mrow data-mjx-texclass="ORD">
    <mo>/</mo>
  </mrow>
  <msqrt>
    <mn>1</mn>
    <mo>+</mo>
    <msup>
      <mi>p</mi>
      <mn>2</mn>
    </msup>
    <mo>+</mo>
    <msup>
      <mi>q</mi>
      <mn>2</mn>
    </msup>
  </msqrt>
</math>