<annotation encoding="application/x-tex">
 \boxed{ F_X(x)= \begin{cases} 0,&amp;x\&lt;a,\\ \dfrac{x-a}{b-a},&amp;a\le x\&lt;b,\\ 1,&amp;x\ge b. \end{cases} }
</annotation></semantics></math>