            <mi>F</mi>
            <mi>X</mi>
          </msub>
          <mo stretchy="false">(</mo>
          <mi>x</mi>
          <mo stretchy="false">)</mo>
          <mo>=</mo>
          <mrow data-mjx-texclass="INNER">
            <mo data-mjx-texclass="OPEN">{</mo>
            <mtable columnalign="left left" columnspacing="1em" rowspacing=".2em">
              <mtr>
                <mtd>
                  <mn>0</mn>
                  <mo>,</mo>
                </mtd>
                <mtd>
                  <mi>x</mi>
                  <mo>&lt;</mo>
                  <mi>a</mi>
                  <mo>,</mo>
                </mtd>
              </mtr>
              <mtr>
                <mtd>
                  <mstyle displaystyle="true" scriptlevel="0">
                    <mfrac>
                      <mrow>
                        <mi>x</mi>
                        <mo>−</mo>
                        <mi>a</mi>
                      </mrow>
                      <mrow>
                        <mi>b</mi>
                        <mo>−</mo>
