<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mi>H</mi>
  <mo>=</mo>
  <mi>p</mi>
  <mfrac>
    <mi>p</mi>
    <mi>m</mi>
  </mfrac>
  <mo>&#x2212;</mo>
  <mrow data-mjx-texclass="INNER">
    <mo data-mjx-texclass="OPEN">(</mo>
    <mfrac>
      <mn>1</mn>
      <mn>2</mn>
    </mfrac>
    <mi>m</mi>
    <mfrac>
      <msup>
        <mi>p</mi>
        <mn>2</mn>
      </msup>
      <msup>
        <mi>m</mi>
        <mn>2</mn>
      </msup>
    </mfrac>
    <mo>&#x2212;</mo>
    <mi>V</mi>
    <mo stretchy="false">(</mo>
    <mi>q</mi>
    <mo stretchy="false">)</mo>
    <mo data-mjx-texclass="CLOSE">)</mo>
  </mrow>
  <mo>=</mo>
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mfrac>
            <msup>
              <mi>p</mi>
              <mn>2</mn>
            </msup>
            <mrow>
              <mn>2</mn>
              <mi>m</mi>
            </mrow>
          </mfrac>
          <mo>+</mo>
          <mi>V</mi>
          <mo stretchy="false">(</mo>
          <mi>q</mi>
          <mo stretchy="false">)</mo>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
</math>