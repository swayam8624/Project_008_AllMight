<math xmlns="http://www.w3.org/1998/Math/MathML">
  <msqrt>
    <munder>
      <mo data-mjx-texclass="OP">&#x2211;</mo>
      <mi>i</mi>
    </munder>
    <mo stretchy="false">(</mo>
    <msub>
      <mi>x</mi>
      <mi>i</mi>
    </msub>
    <mo>&#x2212;</mo>
    <msub>
      <mrow data-mjx-texclass="ORD">
        <mover>
          <mi>x</mi>
          <mo>^</mo>
        </mover>
      </mrow>
      <mi>i</mi>
    </msub>
    <msup>
      <mo stretchy="false">)</mo>
      <mn>2</mn>
    </msup>
    <mrow data-mjx-texclass="ORD">
      <mo>/</mo>
    </mrow>
    <mi>N</mi>
  </msqrt>
</math>