          <mi>S</mi>
          <msub>
            <mi>E</mi>
            <mrow data-mjx-texclass="ORD">
              <mi>R</mi>
              <mi>G</mi>
              <mi>B</mi>
            </mrow>
          </msub>
          <mo>=</mo>
          <msqrt>
            <mfrac>
              <mrow>
                <munder>
                  <mo data-mjx-texclass="OP">&#x2211;</mo>
                  <mrow data-mjx-texclass="ORD">
                    <mi>p</mi>
                  </mrow>
                </munder>
                <mo stretchy="false">[</mo>
                <mo stretchy="false">(</mo>
                <mi mathvariant="normal">&#x394;</mi>
                <msub>
                  <mi>R</mi>
                  <mi>p</mi>
                </msub>
                <msup>
                  <mo stretchy="false">)</mo>
                  <mn>2</mn>
                </msup>
                <mo>+</mo>
                <mo stretchy="false">(</mo>
                <mi mathvariant="normal">&#x394;</mi>
                <msub>
                  <mi>G</mi>
                  <mi>p</mi>
                </msub>
                <msup>
                  <mo stretchy="false">)</mo>
                  <mn>2</mn>
                </msup>
                <mo>+</mo>
                <mo stretchy="false">(</mo>
                <mi mathvariant="normal">&#x394;</mi>
                <msub>
