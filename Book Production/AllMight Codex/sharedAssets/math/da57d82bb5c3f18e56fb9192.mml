<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <msub>
    <mrow data-mjx-texclass="ORD">
      <mover>
        <mi>I</mi>
        <mo stretchy="false">&#xAF;</mo>
      </mover>
    </mrow>
    <mi>R</mi>
  </msub>
  <mo>=</mo>
  <mfrac>
    <mn>1</mn>
    <mi>R</mi>
  </mfrac>
  <munderover>
    <mo data-mjx-texclass="OP">&#x2211;</mo>
    <mrow data-mjx-texclass="ORD">
      <mi>r</mi>
      <mo>=</mo>
      <mn>1</mn>
    </mrow>
    <mrow data-mjx-texclass="ORD">
      <mi>R</mi>
    </mrow>
  </munderover>
  <msup>
    <mrow data-mjx-texclass="ORD">
      <mover>
        <mi>I</mi>
        <mo>^</mo>
      </mover>
    </mrow>
    <mrow data-mjx-texclass="ORD">
      <mo stretchy="false">(</mo>
      <mi>r</mi>
      <mo stretchy="false">)</mo>
    </mrow>
  </msup>
  <mo>.</mo>
