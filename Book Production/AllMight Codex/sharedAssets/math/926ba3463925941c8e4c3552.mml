<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <mrow data-mjx-texclass="ORD">
    <mover>
      <mi>&#x3BC;</mi>
      <mo stretchy="false">^</mo>
    </mover>
  </mrow>
  <mo>=</mo>
  <mfrac>
    <mn>1</mn>
    <mi>T</mi>
  </mfrac>
  <munder>
    <mo data-mjx-texclass="OP">&#x2211;</mo>
    <mi>t</mi>
  </munder>
  <mfrac>
    <mrow>
      <mrow data-mjx-texclass="ORD">
        <mn mathvariant="bold">1</mn>
      </mrow>
      <mo stretchy="false">[</mo>
      <msub>
        <mi>A</mi>
        <mi>t</mi>
      </msub>
      <mo>=</mo>
      <mi>a</mi>
      <mo stretchy="false">]</mo>
      <msub>
        <mi>X</mi>
        <mi>t</mi>
      </msub>
    </mrow>
    <mrow>
      <msub>
        <mi>p</mi>
        <mi>t</mi>
      </msub>
      <mo stretchy="false">(</mo>
      <mi>a</mi>
      <mo stretchy="false">)</mo>
    </mrow>
  </mfrac>
  <mo>.</mo>
</math>