<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">
  <menclose notation="box">
    <mrow data-mjx-texclass="ORD">
      <mstyle displaystyle="true" scriptlevel="0">
        <mrow data-mjx-texclass="ORD">
          <mi>MAE</mi>
          <mo>=</mo>
          <mfrac>
            <mn>1</mn>
            <mi>N</mi>
          </mfrac>
          <munderover>
            <mo data-mjx-texclass="OP">&#x2211;</mo>
            <mrow data-mjx-texclass="ORD">
              <mi>i</mi>
              <mo>=</mo>
              <mn>1</mn>
            </mrow>
            <mrow data-mjx-texclass="ORD">
              <mi>N</mi>
            </mrow>
          </munderover>
          <mrow data-mjx-texclass="ORD">
            <mo stretchy="false">|</mo>
          </mrow>
          <msub>
            <mrow data-mjx-texclass="ORD">
              <mover>
                <mi>y</mi>
                <mo stretchy="false">^</mo>
              </mover>
            </mrow>
            <mi>i</mi>
          </msub>
          <mo>&#x2212;</mo>
          <msub>
            <mi>y</mi>
            <mi>i</mi>
          </msub>
          <mo stretchy="false">|</mo>
        </mrow>
      </mstyle>
    </mrow>
  </menclose>
  <mo>.</mo>
</math>